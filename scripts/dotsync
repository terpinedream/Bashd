#!/bin/bash
# One-command dotfiles sync: pull, link into $HOME, or push.
# Config: ~/.config/bashd/dotsync.conf (REPO=, optional PATHS=)
# Subcommands: setup, pull, link, push

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/bashd/dotsync.conf"

usage() {
    echo "Usage: dotsync <setup|pull|link|push> [options]"
    echo "  setup <path_to_repo>   Create config with REPO=path (link all top-level by default)"
    echo "  pull                  git pull in repo"
    echo "  link                  Symlink repo files into \$HOME (backup existing if needed)"
    echo "  push [-m \"message\"]   git add -A, commit, push (-m for custom commit message)"
    exit 1
}

load_config() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        echo "✗ No config. Run: dotsync setup <path_to_repo>"
        exit 1
    fi
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
    if [[ -z "${REPO:-}" ]] || [[ ! -d "$REPO" ]]; then
        echo "✗ REPO not set or missing in $CONFIG_FILE"
        exit 1
    fi
}

# dotsync setup <path>
if [[ "$1" == "setup" ]]; then
    if [[ -z "${2:-}" ]]; then
        echo "Usage: dotsync setup <path_to_repo>"
        exit 1
    fi
    repo_path=$(realpath "$2" 2>/dev/null || echo "$2")
    if [[ ! -d "$repo_path" ]]; then
        echo "✗ Not a directory: $2"
        exit 1
    fi
    config_dir="${CONFIG_FILE%/*}"
    mkdir -p "$config_dir" || { echo "✗ Failed to create $config_dir"; exit 1; }
    echo "REPO=\"$repo_path\"" > "$CONFIG_FILE"
    echo "# Optional: PATHS=(.bashrc .config/nvim) to link only these; leave unset to link all top-level" >> "$CONFIG_FILE"
    echo "✓ Config written to $CONFIG_FILE (REPO=$repo_path)"
    exit 0
fi

case "${1:-}" in
    pull)
        load_config
        if ! git -C "$REPO" rev-parse --git-dir &>/dev/null; then
            echo "✗ Not a git repo: $REPO"
            exit 1
        fi
        if git -C "$REPO" pull; then
            echo "✓ Pulled"
        else
            echo "✗ git pull failed"
            exit 1
        fi
        ;;
    link)
        load_config
        if [[ -n "${PATHS:-}" ]] && [[ ${#PATHS[@]} -gt 0 ]]; then
            paths_list=("${PATHS[@]}")
        else
            paths_list=()
            while IFS= read -r -d '' name; do
                [[ "$name" == ".git" ]] && continue
                [[ -n "$name" ]] && paths_list+=("$name")
            done < <(find "$REPO" -maxdepth 1 -mindepth 1 \( -type f -o -type d \) -printf '%P\0' 2>/dev/null | sort -z)
        fi

        for rel in "${paths_list[@]}"; do
            [[ -z "$rel" ]] && continue
            src="$REPO/$rel"
            dest="$HOME/$rel"
            if [[ ! -e "$src" ]]; then
                echo "✗ Missing in repo: $rel"
                exit 1
            fi
            src_real=$(realpath "$src" 2>/dev/null) || src_real="$src"
            if [[ -e "$dest" ]]; then
                dest_real=$(realpath "$dest" 2>/dev/null) || dest_real="$dest"
                if [[ "$dest_real" == "$src_real" ]]; then
                    continue
                fi
                backup="$dest.bak.$(date +%Y%m%d)"
                if [[ -e "$backup" ]]; then
                    backup="$dest.bak.$(date +%Y%m%d_%H%M%S)"
                fi
                if ! mv "$dest" "$backup"; then
                    echo "✗ Failed to backup $dest"
                    exit 1
                fi
            fi
            dest_parent=$(dirname "$dest")
            mkdir -p "$dest_parent" || { echo "✗ Failed to create $dest_parent"; exit 1; }
            if ! ln -sf "$src_real" "$dest"; then
                echo "✗ Failed to link $rel"
                exit 1
            fi
        done
        echo "✓ Linked ${#paths_list[@]} path(s)"
        ;;
    push)
        load_config
        if ! git -C "$REPO" rev-parse --git-dir &>/dev/null; then
            echo "✗ Not a git repo: $REPO"
            exit 1
        fi
        msg=""
        if [[ "${2:-}" == "-m" ]] && [[ -n "${3:-}" ]]; then
            msg="$3"
        else
            msg="dotsync $(date '+%Y-%m-%d %H:%M')"
        fi
        git -C "$REPO" add -A
        if git -C "$REPO" diff --staged --quiet 2>/dev/null; then
            echo "Nothing to commit"
            exit 0
        fi
        if ! git -C "$REPO" commit -m "$msg"; then
            echo "✗ git commit failed"
            exit 1
        fi
        if ! git -C "$REPO" push; then
            echo "✗ git push failed"
            exit 1
        fi
        echo "✓ Pushed"
        ;;
    "")
        usage
        ;;
    *)
        echo "Unknown subcommand: $1"
        usage
        ;;
esac
