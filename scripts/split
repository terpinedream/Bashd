#!/bin/bash
# Split loose files in CWD into N roughly equal subdirectories.
# split <N>   Creates part_1/ ... part_N/ and distributes files round-robin.

usage() {
  echo "Usage: split <N>" >&2
  echo "  N = number of subdirectories to create (2+)." >&2
  echo "  Distributes loose files in CWD round-robin into part_1/ ... part_N/." >&2
  exit 1
}

[[ $# -ne 1 ]] && usage
N="$1"
[[ "$N" =~ ^[0-9]+$ ]] || usage
[[ "$N" -lt 2 ]] && { echo "✗ N must be at least 2" >&2; exit 1; }

files=()
for item in ./* ./.[!.]* ..?*; do
  [[ -e "$item" ]] || continue
  [[ -f "$item" ]] || continue
  name=$(basename "$item")
  [[ "$name" == "." || "$name" == ".." ]] && continue
  files+=("$item")
done
[[ ${#files[@]} -eq 0 ]] && { echo "No loose files to split"; exit 0; }

if [[ ${#files[@]} -lt $N ]]; then
  echo "✗ Only ${#files[@]} file(s) — fewer than $N parts" >&2
  exit 1
fi

IFS=$'\n' read -r -d '' -a sorted < <(printf '%s\n' "${files[@]}" | sort) || true
[[ ${#sorted[@]} -eq 0 ]] && sorted=("${files[@]}")

for (( i = 1; i <= N; i++ )); do
  dir="part_${i}"
  if [[ -e "$dir" ]]; then
    echo "✗ Already exists: $dir — remove part_* dirs first" >&2
    exit 1
  fi
done

for (( i = 1; i <= N; i++ )); do
  mkdir "part_${i}" || { echo "✗ Failed to create part_${i}" >&2; exit 1; }
done

moved=0
for (( idx = 0; idx < ${#sorted[@]}; idx++ )); do
  bucket=$(( (idx % N) + 1 ))
  mv -- "${sorted[idx]}" "part_${bucket}/" || { echo "✗ Failed to move ${sorted[idx]}" >&2; exit 1; }
  ((moved++))
done

per=$(( moved / N ))
rem=$(( moved % N ))
echo "✓ Split $moved file(s) into $N parts (~$per each${rem:+, $rem part(s) have $(( per + 1 ))})"
