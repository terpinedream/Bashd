#!/bin/bash
# Bashd — single entry point dispatcher.
# Usage:
#   bashd <command> [args...]    Run a bashd command
#   bashd --help [command]       Show help (general or per-command)
#   bashd --chart                Show the ASCII command chart
#   bashd --list [core|helpers|extra]  List available commands
#   bashd alias                  Print alias definitions

_self_dir="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
if [[ -n "${BASHD_ROOT:-}" && -d "$BASHD_ROOT/core" ]]; then
  :
elif [[ -d "$_self_dir/core" ]]; then
  BASHD_ROOT="$_self_dir"
elif [[ -d "$_self_dir/bashd-scripts/core" ]]; then
  BASHD_ROOT="$_self_dir/bashd-scripts"
elif [[ -d /usr/share/bashd/core ]]; then
  BASHD_ROOT="/usr/share/bashd"
else
  BASHD_ROOT="$_self_dir"
fi

CD_HELPERS="hop ndir crush tmpws bm mark ld cdch qs"

CORE_CMDS="pfx sfx rmpfx rmsfx recase lower gaps namechange undo wrap uwrap nest flatten stick split byext bydate dedupe trim qc bak ubak clip clipd cbwrite cpath cpt sized bring pull"
HELPER_CMDS="$CD_HELPERS"
EXTRA_CMDS="cleanme paclock topd archive pullfrom pushto dotsync bkup template pland"

is_cd_helper() {
  for h in $CD_HELPERS; do [[ "$h" == "$1" ]] && return 0; done
  return 1
}

find_command() {
  local cmd="$1"
  for dir in core helpers extra; do
    if [[ -x "$BASHD_ROOT/$dir/$cmd" ]]; then
      printf '%s' "$BASHD_ROOT/$dir/$cmd"
      return 0
    fi
  done
  return 1
}

category_of() {
  local cmd="$1"
  for c in $CORE_CMDS; do [[ "$c" == "$cmd" ]] && { echo "core"; return; }; done
  for c in $HELPER_CMDS; do [[ "$c" == "$cmd" ]] && { echo "helpers"; return; }; done
  for c in $EXTRA_CMDS; do [[ "$c" == "$cmd" ]] && { echo "extra"; return; }; done
  echo ""
}

list_commands() {
  local filter="${1:-all}"
  if [[ "$filter" == "all" || "$filter" == "core" ]]; then
    echo "Core:"
    for cmd in $CORE_CMDS; do printf '  %s\n' "$cmd"; done
  fi
  if [[ "$filter" == "all" || "$filter" == "helpers" ]]; then
    echo "Helpers (cd-requiring, need bashd-init.sh):"
    for cmd in $HELPER_CMDS; do printf '  %s\n' "$cmd"; done
  fi
  if [[ "$filter" == "all" || "$filter" == "extra" ]]; then
    echo "Extra:"
    for cmd in $EXTRA_CMDS; do printf '  %s\n' "$cmd"; done
  fi
}

# ── Full descriptions for --help <command> ────────────────────────────
get_full_desc() {
  case "$1" in
  paclock) echo "Remove /var/lib/pacman/db.lck when pacman is stuck (run as root)." ;;
  cleanme) echo "Clear caches: no flag = system + pacman; -p pacman only (root); -s system only (~/.cache, Trash)." ;;
  wrap) echo "Move loose files into a dir: wrap = into single subdir; wrap <dir> = into that dir; wrap -c <name> = create dir and move files; wrap -c -a <name> = create dir and move files + dirs." ;;
  crush) echo "Move CWD contents into parent and remove empty CWD. Source bashd-init.sh so running crush also cds to parent (default)." ;;
  uwrap) echo "Unpack directories in CWD: uwrap unpacks all; uwrap path unpacks that dir (if in CWD: move; if outside CWD: copy to CWD). Keeps original names; -p prefixes with the source dir name. Inverse of wrap/stick/split." ;;
  namechange) echo "Mass rename: namechange \"file.txt\" -> 1_file.txt, 2_file.txt, ... (underscore separator; ignores dirs)." ;;
  pull) echo "Move one file/dir to parent: pull <file>." ;;
  bring) echo "Copy a file or directory into CWD: bring <path>. Complements pull (which moves to parent)." ;;
  stick) echo "Create dir and move items whose name contains dir name: stick [-i] [-w] <dir_name>; -i case-insensitive, -w whole-word only. Direct children of CWD only." ;;
  flatten) echo "Move all files from subdirs (any depth) into CWD, prefix each filename with its path (e.g. a/b/file.txt -> a_b_file.txt); then remove empty dirs. Regular files only." ;;
  nest) echo "Create subdir from filename prefix (first delimiter, default _): prefix_rest -> prefix/rest; one level per run. nest [delim] for custom delimiter. Files with no delimiter stay in CWD." ;;
  hop) echo "Quick dir jumps: hop N = cd up N levels; hop name = cd to nearest parent whose basename matches name (case-insensitive). Source bashd-init.sh so hop also cds (like crush)." ;;
  ld) echo "Cd to the last-used directory (previous CWD). Source bashd-init.sh so the shell records CWD on each prompt and ld changes directory. No args." ;;
  ndir) echo "Create a directory and cd into it: ndir new -> mkdir new and cd to new/. Source bashd-init.sh so ndir also cds." ;;
  cdch) echo "Cd to the directory containing the most recently modified file. Searches ~/Downloads, ~/Desktop, and CWD. Override with CDCH_DIRS. Source bashd-init.sh so cdch also cds. Use case: after downloading a file (e.g. in Firefox), run cdch to jump to that file's directory." ;;
  tmpws) echo "Create a temp directory, cd into it, and remove it when the shell exits. -c/--copy: copy CWD contents into the temp dir first. -r/--return: leave temp workspace and return to original dir. Source bashd-init.sh so tmpws also cds; the dir is deleted on terminal close/exit." ;;
  qs) echo "Quick navigation: qs = pick from common dirs (HOME, Documents, Downloads, etc.) and drill down; qs -s PATTERN = fuzzy search directories; qs -f PATTERN = search for file and open in \$EDITOR. Source bashd-init.sh so qs (and qs -s) cd into the chosen directory." ;;
  bm) echo "Directory bookmarks: bm -a [dir] <name> to save (CWD if dir omitted); bm <name> to jump; bm -l to list; bm -d <name> to delete. Names can be numbers or strings (e.g. bm -a . work, then bm work). Source bashd-init.sh so bm <name> cds." ;;
  clip) echo "Copy a file's contents to clipboard: clip <filename>. With no args and a pipe, copies stdin (ls | clip). Uses wl-copy, xclip, xsel, pbcopy, or clip.exe." ;;
  clipd) echo "Copy multiple files to clipboard with separators: clipd file1 file2 ... Each file is preceded by a # /absolute/path/to/file header line. Uses same clipboard tools as clip." ;;
  cbwrite) echo "Write clipboard contents to a file (inverse of clip): cbwrite <filename>. Refuses if file exists; -f to overwrite, -a to append. Uses wl-paste, xclip -o, xsel -o, pbpaste, or powershell.exe." ;;
  sized) echo "Show largest files or directories in CWD, ranked by size. sized = top 10 files; -d = directories; -r = recursive; -n N = top N. Flags combinable. Uses du + sort." ;;
  cpath) echo "Copy a path to clipboard: cpath = CWD path; cpath <file_or_dir> = absolute path of that file or directory. Same clipboard tools as clip." ;;
  trim) echo "Safely remove empty dirs, zero-byte files, .DS_Store, Thumbs.db. Prints list and prompts for confirmation before deleting. -r = recursive. -n = dry run (list only, no deletion)." ;;
  pfx) echo "Add to loose filenames in CWD: -d prepend date (YYYY_MM_DD), -p prepend parent dir name, -i prepend index (001, 002, ...). Flags combinable. Two-phase rename to avoid overwrites." ;;
  sfx) echo "Add suffix before extension: -d date, -p parent dir name, -i index (e.g. base_001.ext). sfx [-d] [-p] [-i]. Complements pfx. Only loose files in CWD." ;;
  rmpfx) echo "Remove prefix segments from filenames at delimiter: pfx_rest.ext -> rest.ext. rmpfx [-d] [-n N] [delim]; -d strips a date prefix (YYYY_MM_DD, 3 segments) with validation; -n N strips N segments (default 1); delim default _. -d and -n are mutually exclusive." ;;
  rmsfx) echo "Remove suffix segments from filenames at delimiter (before extension): base_sfx.ext -> base.ext. rmsfx [-d] [-n N] [delim]; -d strips a date suffix (YYYY_MM_DD, 3 segments) with validation; -n N strips N segments (default 1); delim default _. -d and -n are mutually exclusive." ;;
  recase) echo "Batch rename loose files in CWD to a target case. Splits words on _ - space and camelCase boundaries, then reassembles: -c camelCase, -l lowercase (_), -u UPPERCASE (_), -t Title_Case (_), -k kebab-case (-). Extensions always stay lowercase. Exactly one flag required." ;;
  undo) echo "Reverse the last rename operation (pfx, sfx, rmpfx, rmsfx, recase, namechange, gaps, lower). Must be run from the same directory where the rename occurred. Single-level undo; each rename overwrites the previous log." ;;
  gaps) echo "Re-index numbered files to fill gaps (e.g. hello_01, hello_03, hello_05 -> hello_01, hello_02, hello_03). Detects numeric segment at the first or last delimiter boundary. gaps [delim]; default delimiter _. Preserves padding width. Single-file groups and files without a numeric segment are skipped." ;;
  lower) echo "Sanitize filenames: lowercase, replace spaces/special chars with underscores, collapse runs. My File (Copy) [2].jpg -> my_file_copy_2.jpg. Extensions stay lowercase. Supports undo." ;;
  split) echo "Split loose files in CWD into N roughly equal subdirectories: split 3 creates part_1/, part_2/, part_3/ and distributes files round-robin. N must be at least 2 and no greater than file count." ;;
  mark) echo "Session breadcrumb trail: mark -a to drop a mark at CWD, mark -l to list, mark (no args) to pick and jump. Trail is per-terminal session and clears on shell exit. Source bashd-init.sh for cd support." ;;
  byext) echo "Move loose files in CWD into subdirs by extension: file.pdf -> pdf/file.pdf; files with no extension go into noext/." ;;
  bydate) echo "Move loose files in CWD into date subdirs by mtime. Default: YYYY/MM/DD. -M for YYYY/MM only. bydate [-M]." ;;
  dedupe) echo "Find duplicate files by content hash (sha256sum/shasum -a 256); keep first in place, move rest to _dupes/ with disambiguated names. -r = recurse into subdirs. Regular files only." ;;
  archive) echo "Archive to remote/HDD: options -w work, -i image, -v video, -e extra, -k keys, -c crypt, -p path." ;;
  bak) echo "Backup files: bak <file> [file2] ... renames each to name.ext.bak and creates a working copy. bak * backs up all files in CWD. Skips directories and existing .bak files." ;;
  ubak) echo "Restore .bak files: ubak <file.bak> or ubak (all in CWD). If identical, removes .bak. If original differs: -k to keep original and discard .bak, -r to revert (replace original with .bak), -f alias for -k." ;;
  bkup) echo "Backup CWD to a directory: bkup setup <path> to set default; then bkup or bkup -f; or bkup [-f] <path> to override; -f overwrites if destination not empty." ;;
  pullfrom) echo "Pull from remote: pullfrom <remote_path> <local_path>." ;;
  pushto) echo "Push to remote: pushto <local_path> <remote_path>." ;;
  dotsync) echo "Dotfiles sync: dotsync setup <repo>, pull, link, push [-m \"msg\"]; config in ~/.config/bashd/dotsync.conf (REPO=, optional PATHS=)." ;;
  topd) echo "Top 3 by CPU; press 1/2/3 (or k1/k2/k3) to kill, q to quit. Ignores system-critical processes (WM, compositor, DE, pipewire, etc.). --ignore NAME to also ignore processes whose name contains NAME (repeatable)." ;;
  template) echo "Snapshot and recreate directory structures. template save <name> = snapshot CWD structure; template <name> = recreate it; template -l = list; template -d <name> = delete. Templates stored in ~/.config/bashd/templates/." ;;
  cpt) echo "Copy the output of the last terminal command to clipboard. Shows the command, asks for confirmation, re-runs it with output captured. cpt = confirm first; cpt -y = skip confirmation." ;;
  qc) echo "Quick interactive file deletion: list items in CWD, pick numbers to delete. qc = all items; qc <pattern> = filter by case-insensitive substring. Confirms before deleting." ;;
  pland) echo "Create incremental plan markdown files for LLM prompts. pland = create next PLAN/PLAN_NN.md with template sections (Objective, Context, Requirements, Approach, etc.); pland -e = create and open in \$EDITOR." ;;
  *) return 1 ;;
  esac
}

# ── --chart: ASCII chart ──────────────────────────────────────────────
W=70
_top() { printf '+%*s+\n' "$((W - 2))" '' | tr ' ' '-'; }
_bot() { printf '+%*s+\n' "$((W - 2))" '' | tr ' ' '-'; }
_sep() { printf '+%*s+\n' "$((W - 2))" '' | tr ' ' '-'; }
_row() { printf '| %-*s |\n' "$((W - 4))" "$1"; }
_sec() { printf '| %-*s |\n' "$((W - 4))" "$1"; }
_item() { printf '|   %-12s %-*s |\n' "$1" "$((W - 19))" "$2"; }

show_chart() {
  _top
  if command -v figlet &>/dev/null; then
    figlet -f standard "Bashd" 2>/dev/null | while IFS= read -r line; do
      _row "${line:0:$((W - 4))}"
    done
  else
    _row "Bashd"
  fi
  _row ""
  _sep
  _sec "CORE  (rename, organize, clipboard, cleanup)"
  _item "pfx" "-d date, -p parent, -i index; combinable"
  _item "sfx" "-d date, -p parent, -i index; before ext"
  _item "rmpfx" "Strip prefix at delim; -d date; -n N [delim]"
  _item "rmsfx" "Strip suffix at delim; -d date; -n N [delim]"
  _item "recase" "-c camel -l lower -u upper -t title -k kebab"
  _item "lower" "Sanitize filenames: lowercase + strip junk"
  _item "gaps" "Re-index numbered files to fill gaps"
  _item "namechange" "Mass rename in CWD: namechange \"file.txt\""
  _item "undo" "Reverse last rename (single-level)"
  _item "wrap" "Move files into dir; -c create; -c -a +dirs"
  _item "uwrap" "Unpack dirs into CWD; keep names; -p prefix"
  _item "nest" "prefix_rest -> prefix/rest; one level; [delim]"
  _item "flatten" "Move subdir files to CWD, prefix with path"
  _item "stick" "Create dir, move items containing name; -i -w"
  _item "split" "Split loose files into N equal subdirs"
  _item "byext" "Move files into ext/ dirs (noext if no ext)"
  _item "bydate" "Move files into YYYY/MM/DD dirs; -M month"
  _item "dedupe" "Duplicates by hash -> _dupes/; -r recurse"
  _item "trim" "Remove junk + empty dirs; -r recurse; -n dry run"
  _item "qc" "Quick delete: pick files to remove; qc [pattern]"
  _item "bak" "Backup files: bak <file> ... or bak * for all"
  _item "ubak" "Restore/clean .bak files; smart diff; -k -r -f"
  _item "clip" "Copy a file or stdin to clipboard"
  _item "clipd" "Copy multiple files to clipboard; # separators"
  _item "cbwrite" "Clipboard -> file; -f overwrite, -a append"
  _item "cpath" "Copy CWD or file/dir path to clipboard"
  _item "cpt" "Copy last command output to clipboard"
  _item "sized" "Largest files/dirs: -d dirs, -r recurse, -n N"
  _item "bring" "Copy file or dir into CWD"
  _item "pull" "Move one file/dir to parent"
  _row ""
  _sep
  _sec "HELPERS  (cd-requiring, need bashd-init.sh)"
  _item "hop" "hop N = up N levels; hop name = match parent"
  _item "ndir" "mkdir <name> and cd into it"
  _item "crush" "Move CWD to parent, remove dir"
  _item "tmpws" "temp workspace; -c copy CWD; -r return"
  _item "bm" "bm -a [dir] name; bm name; -l list; -d del"
  _item "mark" "Session breadcrumb trail: -a mark, -l list"
  _item "ld" "cd to last-used directory (previous CWD)"
  _item "cdch" "cd to dir of most recently modified file"
  _item "qs" "quick nav: pick dir or qs -s PATTERN; -f file"
  _row ""
  _sep
  _sec "EXTRA  (niche, system-specific, personal)"
  _item "cleanme" "Clear caches: -p pacman, -s system, or both"
  _item "paclock" "Remove db.lck when pacman is stuck (root)"
  _item "topd" "Top 3 by CPU; 1/2/3 to kill. --ignore NAME"
  _item "archive" "Archive to remote/HDD: -w/-i/-v/-e/-k/-c/-p"
  _item "bkup" "Backup CWD: bkup setup <path>; then bkup"
  _item "pullfrom" "Pull from remote: pullfrom <remote> <local>"
  _item "pushto" "Push to remote: pushto <local> <remote>"
  _item "dotsync" "Dotfiles: setup, pull, link, push"
  _item "template" "Save/recreate dir structures; save, -l, -d"
  _item "pland" "Create PLAN/PLAN_NN.md for LLM prompts; -e"
  _row ""
  _bot
  echo ""
  echo "Usage: bashd <command> [args] | bashd --help [cmd] | bashd --list [category]"
}

show_command_help() {
  local cmd="$1"
  local desc
  desc=$(get_full_desc "$cmd")
  if [[ -z "$desc" ]]; then
    echo "Unknown command: $cmd" >&2
    echo "Run 'bashd --list' to see available commands." >&2
    exit 1
  fi
  _top
  if command -v figlet &>/dev/null; then
    figlet -f standard "$cmd" 2>/dev/null | while IFS= read -r line; do
      _row "${line:0:$((W - 4))}"
    done
  else
    _row "$cmd"
  fi
  _row ""
  local width=$((W - 4))
  while read -r line; do
    while [[ ${#line} -gt width ]]; do
      chunk="${line:0:$width}"
      last_space="${chunk% *}"
      if [[ "$last_space" != "$chunk" ]] && [[ ${#last_space} -gt $((width / 2)) ]]; then
        _row "$last_space"
        line="${line:${#last_space}+1}"
      else
        _row "$chunk"
        line="${line:$width}"
      fi
    done
    [[ -n "$line" ]] && _row "$line"
  done <<<"$desc"
  _row ""
  local cat
  cat=$(category_of "$cmd")
  [[ -n "$cat" ]] && _row "Category: $cat"
  is_cd_helper "$cmd" && _row "Note: requires bashd-init.sh for cd support"
  _bot
  echo ""
}

# ── alias subcommand ──────────────────────────────────────────────────
show_aliases() {
  local conf="${XDG_CONFIG_HOME:-$HOME/.config}/bashd/aliases.conf"
  if [[ "${1:-}" == "--default" ]]; then
    mkdir -p "$(dirname "$conf")"
    {
      echo "# Bashd aliases — one command per line."
      echo "# Commands listed here can be run without the 'bashd' prefix."
      echo "# Run 'bashd alias --default' to regenerate this file."
      for cmd in $CORE_CMDS; do echo "$cmd"; done
      for cmd in $HELPER_CMDS; do echo "$cmd"; done
    } > "$conf"
    echo "Default aliases written to $conf"
    return
  fi

  local cmds=()
  if [[ -f "$conf" ]]; then
    while IFS= read -r line; do
      line="${line%%#*}"
      line="${line// /}"
      [[ -z "$line" ]] && continue
      cmds+=("$line")
    done < "$conf"
  else
    for cmd in $CORE_CMDS $HELPER_CMDS; do cmds+=("$cmd"); done
  fi

  echo "# Bashd aliases (paste into your shell rc, or source bashd-init.sh):"
  echo "# CD-requiring helpers need bashd-init.sh (these match its wrappers)."
  for cmd in "${cmds[@]}"; do
    case "$cmd" in
      crush) echo 'crush() { eval "$(bashd crush "$@")"; }' ;;
      ld)    echo 'ld() { eval "$(bashd ld "$@")"; }' ;;
      hop)   echo 'hop() { eval "$(bashd hop "$@")"; }' ;;
      ndir)  echo 'ndir() { eval "$(bashd ndir "$@")"; }' ;;
      cdch)  echo 'cdch() { eval "$(bashd cdch "$@")"; }' ;;
      bm)
        echo 'bm() {'
        echo '  if [[ "${1:-}" == "-a" || "${1:-}" == "-d" || "${1:-}" == "-l" ]]; then bashd bm "$@"; else eval "$(bashd bm "$@")"; fi'
        echo '}'
        ;;
      mark)
        echo 'mark() {'
        echo '  if [[ "${1:-}" == "-a" || "${1:-}" == "-l" ]]; then bashd mark "$@"; else eval "$(bashd mark "$@")"; fi'
        echo '}'
        ;;
      tmpws)
        echo 'tmpws() {'
        echo '  local need_cwd=false'
        echo '  for a in "$@"; do [[ "$a" == "-c" || "$a" == "--copy" ]] && need_cwd=true; done'
        echo '  if [[ "${1:-}" == "-r" || "${1:-}" == "--return" ]]; then eval "$(bashd tmpws "$@")"'
        echo '  elif $need_cwd; then eval "$(bashd tmpws "$@" "$(pwd)")"'
        echo '  else eval "$(bashd tmpws "$@")"; fi'
        echo '}'
        ;;
      qs)
        echo 'qs() {'
        echo '  if [[ "${1:-}" == "-f" || "${1:-}" == "--file" || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then bashd qs "$@"; else'
        echo '    local p; p=$(bashd qs "$@"); [[ -n "$p" && -d "$p" ]] && cd "$p"'
        echo '  fi'
        echo '}'
        ;;
      *) echo "alias ${cmd}='bashd ${cmd}'" ;;
    esac
  done
}

# ── Main dispatch ─────────────────────────────────────────────────────
usage() {
  echo "Usage: bashd <command> [args...]" >&2
  echo "       bashd --help [command]     Show help" >&2
  echo "       bashd --chart              ASCII command chart" >&2
  echo "       bashd --list [category]    List commands" >&2
  echo "       bashd alias [--default]    Show/generate alias config" >&2
  exit 0
}

if [[ $# -eq 0 ]]; then
  show_chart
  exit 0
fi

case "$1" in
  -h|--help)
    if [[ -n "${2:-}" ]]; then
      show_command_help "$2"
    else
      usage
    fi
    exit 0
    ;;
  --chart)
    show_chart
    exit 0
    ;;
  --list)
    list_commands "${2:-all}"
    exit 0
    ;;
  alias)
    shift
    show_aliases "$@"
    exit 0
    ;;
  -*)
    echo "Unknown option: $1" >&2
    usage
    ;;
esac

cmd="$1"
shift

script_path=$(find_command "$cmd")
if [[ -z "$script_path" ]]; then
  echo "bashd: unknown command '$cmd'" >&2
  echo "Run 'bashd --list' to see available commands." >&2
  exit 1
fi

exec "$script_path" "$@"
