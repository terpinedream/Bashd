#!/bin/bash
# Add suffix to loose filenames in CWD (before extension): -d date, -p parent dir name, -i index.
# sfx [-d] [-p] [-i]  Flags combinable. Only regular files, direct children. Complements pfx.

usage() {
  echo "Usage: sfx [-d] [-p] [-i]" >&2
  echo "  -d  Append date before extension (base_YYYY_MM_DD.ext)" >&2
  echo "  -p  Append parent directory name before extension" >&2
  echo "  -i  Append incremental index before extension (base_001.ext)" >&2
  echo "  At least one flag required. Only loose files in CWD." >&2
  exit 1
}

DO_DATE=false
DO_PARENT=false
DO_INDEX=false
while getopts "dpi" opt; do
  case $opt in
    d) DO_DATE=true ;;
    p) DO_PARENT=true ;;
    i) DO_INDEX=true ;;
    *) usage ;;
  esac
done
shift $((OPTIND-1))
[[ $# -gt 0 ]] && usage
[[ "$DO_DATE" != true ]] && [[ "$DO_PARENT" != true ]] && [[ "$DO_INDEX" != true ]] && usage

source "$(dirname "$(readlink -f "$0")")/_bashd_log"

parent_name=$(basename "$(pwd)")
date_str=$(date +%Y_%m_%d)

files=()
for item in ./* ./.[!.]* ..?*; do
  [[ -e "$item" ]] || continue
  [[ -f "$item" ]] || continue
  name=$(basename "$item")
  [[ "$name" == "." || "$name" == ".." ]] && continue
  files+=("$item")
done
[[ ${#files[@]} -eq 0 ]] && { echo "No files to sfx"; exit 0; }

IFS=$'\n' read -r -d '' -a sorted < <(printf '%s\n' "${files[@]}" | sort) || true
[[ ${#sorted[@]} -eq 0 ]] && sorted=("${files[@]}")

tmp_suffix=".sfx.$$"
bashd_log_start "sfx"
i=1
for f in "${sorted[@]}"; do
  [[ -e "$f" ]] || continue
  base=$(basename "$f")
  ext=""
  if [[ "$base" == *.* ]]; then
    ext=".${base##*.}"
    base="${base%.*}"
  fi
  newbase="$base"
  [[ "$DO_DATE" == true ]] && newbase="${newbase}_${date_str}"
  [[ "$DO_PARENT" == true ]] && newbase="${newbase}_${parent_name}"
  [[ "$DO_INDEX" == true ]] && newbase="${newbase}_$(printf '%03d' "$i")"
  newname="${newbase}${ext}"
  n=2
  while [[ -e "$newname" ]]; do
    newname="${newbase}_${n}${ext}"
    ((n++))
  done
  mv -- "$f" "${newname}${tmp_suffix}" || { echo "✗ Failed to rename $f" >&2; exit 1; }
  bashd_log "$(basename "$f")" "$newname"
  ((i++))
done
for item in *"${tmp_suffix}"; do
  [[ -e "$item" ]] || [[ -L "$item" ]] || continue
  final="${item%${tmp_suffix}}"
  mv -- "$item" "$final" || { echo "✗ Failed to finalize $item" >&2; exit 1; }
done
echo "✓ Sfx'd ${#files[@]} file(s)"
