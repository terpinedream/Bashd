#!/bin/bash

usage() {
  echo "Usage: pushto <local_path> <remote_path>" >&2
  echo "  Push files to REMOTE_HOST (see ~/.config/bashd/remote.conf)." >&2
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

if [ "$#" -ne 2 ]; then
  usage
  exit 1
fi

source "$(dirname "$(readlink -f "$0")")/../_bashd_remote"
bashd_load_remote || exit 1

LOCAL_PATH="$1"
REMOTE_PATH="$2"

scp -r "$LOCAL_PATH" "${REMOTE_HOST}:${REMOTE_PATH}"

if [ $? -eq 0 ]; then
  echo "✓ Successfully pushed to remote"
else
  echo "✗ Transfer failed"
  exit 1
fi
