#!/bin/bash

usage() {
  echo "Usage: pullfrom <remote_path> <local_path>" >&2
  echo "  Pull files from REMOTE_HOST (see ~/.config/bashd/remote.conf)." >&2
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

if [ "$#" -ne 2 ]; then
  usage
  exit 1
fi

source "$(dirname "$(readlink -f "$0")")/../_bashd_remote"
bashd_load_remote || exit 1

REMOTE_PATH="$1"
LOCAL_PATH="$2"

scp -r "${REMOTE_HOST}:${REMOTE_PATH}" "$LOCAL_PATH"

if [ $? -eq 0 ]; then
  echo "✓ Successfully pulled from remote"
else
  echo "✗ Transfer failed"
  exit 1
fi
