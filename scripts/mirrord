#!/bin/bash
# Rank Arch pacman mirrors by speed; optionally save to /etc/pacman.d/mirrorlist.
# Uses reflector if available, else rankmirrors (pacman-contrib).
# Default: save top 15 mirrors (requires root). --list-only prints without saving.

MIRRORLIST="/etc/pacman.d/mirrorlist"
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/bashd/mirrord.conf"
DEFAULT_N=15

usage() {
    echo "Usage: mirrord [-n N|--number N] [-c CC|--country CC] [--list-only]"
    echo "  Rank mirrors by speed. Saves to $MIRRORLIST (requires root)."
    echo "  -n, --number N   Use top N mirrors (default: $DEFAULT_N)"
    echo "  -c, --country CC Comma-separated country codes (e.g. US,CA)"
    echo "  --list-only      Print mirrorlist to stdout, do not write (no root)"
    echo "  Config (optional): $CONFIG_FILE (MIRRORD_NUMBER=15, MIRRORD_COUNTRY=US,CA)"
    exit 1
}

# Load config if present
if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
fi

N="${MIRRORD_NUMBER:-$DEFAULT_N}"
COUNTRY="${MIRRORD_COUNTRY:-}"
LIST_ONLY=false

# Parse args (override config)
while [[ $# -gt 0 ]]; do
    case "$1" in
        -n|--number)
            N="$2"
            shift 2
            ;;
        -c|--country)
            COUNTRY="$2"
            shift 2
            ;;
        --list-only)
            LIST_ONLY=true
            shift
            ;;
        -h|--help)
            usage
            ;;
        *)
            echo "Unknown option: $1"
            usage
            ;;
    esac
done

# Validate N
if ! [[ "$N" =~ ^[0-9]+$ ]] || [[ "$N" -lt 1 ]]; then
    echo "✗ Number must be a positive integer"
    exit 1
fi

if [[ "$LIST_ONLY" != true ]] && [[ $EUID -ne 0 ]]; then
    echo "Writing to $MIRRORLIST requires root (e.g. sudo mirrord)"
    exit 1
fi

if command -v reflector &>/dev/null; then
    args=(--latest "$N" --sort rate)
    [[ -n "$COUNTRY" ]] && args+=(--country "$COUNTRY")
    if [[ "$LIST_ONLY" == true ]]; then
        if reflector "${args[@]}"; then
            echo "✓ Ranked mirrors (reflector)" >&2
        else
            echo "✗ reflector failed" >&2
            exit 1
        fi
    else
        args+=(--save "$MIRRORLIST")
        if reflector "${args[@]}"; then
            echo "✓ Updated $MIRRORLIST (reflector, top $N)"
        else
            echo "✗ reflector failed"
            exit 1
        fi
    fi
elif command -v rankmirrors &>/dev/null; then
    if [[ ! -f "$MIRRORLIST" ]]; then
        echo "✗ No $MIRRORLIST found; install reflector to fetch a fresh list"
        exit 1
    fi
    if [[ "$LIST_ONLY" == true ]]; then
        if rankmirrors -n "$N" "$MIRRORLIST"; then
            echo "✓ Ranked mirrors (rankmirrors)" >&2
        else
            echo "✗ rankmirrors failed" >&2
            exit 1
        fi
    else
        tmp=$(mktemp)
        if rankmirrors -n "$N" "$MIRRORLIST" > "$tmp" && mv "$tmp" "$MIRRORLIST"; then
            echo "✓ Updated $MIRRORLIST (rankmirrors, top $N)"
        else
            rm -f "$tmp"
            echo "✗ rankmirrors failed"
            exit 1
        fi
    fi
else
    echo "✗ Neither reflector nor rankmirrors found. Install reflector (recommended) or pacman-contrib"
    exit 1
fi
