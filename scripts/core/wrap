#!/bin/bash
# Move loose files into a directory. Combines former fold + cram.
# wrap                      Move loose files into the single subdir in CWD
# wrap <existing_dir>       Move loose files into that directory
# wrap -c <new_name>        Create new dir, move files into it
# wrap -c -a <new_name>     Create new dir, move files AND dirs into it
# wrap -n                   Dry run

usage() {
    echo "Usage: wrap [-n] [dir]  |  wrap -c [-a] [-n] <new_name>" >&2
    echo "  wrap              Move loose files into the single subdir" >&2
    echo "  wrap <dir>        Move loose files into existing dir" >&2
    echo "  wrap -c <name>    Create dir and move files into it" >&2
    echo "  wrap -c -a <name> Create dir and move files + dirs into it" >&2
    echo "  -n                Dry run (list only)" >&2
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

source "$(dirname "$(readlink -f "$0")")/../_bashd_files"
bashd_refuse_home_root || exit 1

CREATE=false
ALL=false
DRY_RUN=false
while getopts "cahn" opt; do
    case $opt in
        c) CREATE=true ;;
        a) ALL=true ;;
        n) DRY_RUN=true ;;
        h) usage; exit 0 ;;
        *) usage; exit 1 ;;
    esac
done
shift $((OPTIND-1))

$ALL && ! $CREATE && { echo "✗ -a requires -c" >&2; exit 1; }

move_item() {
    local src="$1" dest="$2"
    if $DRY_RUN; then
        echo "  would move $src -> $dest"
        return 0
    fi
    mv -- "$src" "$dest" || { echo "✗ Failed to move $src" >&2; exit 1; }
}

if $CREATE; then
    [[ $# -ne 1 ]] && { usage; exit 1; }
    DIRNAME="$1"

    [[ -e "$DIRNAME" ]] && { echo "✗ Already exists: $DIRNAME" >&2; exit 1; }
    if ! $DRY_RUN; then
        mkdir -p "$DIRNAME" || { echo "✗ Failed to create $DIRNAME" >&2; exit 1; }
    fi

    count=0
    for item in ./* ./.[!.]* ..?*; do
        [[ -e "$item" ]] || continue
        name=$(basename "$item")
        [[ "$name" == "." || "$name" == ".." ]] && continue
        [[ "$name" == "$DIRNAME" ]] && continue
        if ! $ALL && [[ -d "$item" ]]; then
            continue
        fi
        move_item "$item" "$DIRNAME/"
        ((count++)) || true
    done
    if $DRY_RUN; then
        echo "Would create $DIRNAME/ and move $count item(s) into it"
    else
        echo "✓ Created $DIRNAME/ and moved $count item(s) into it"
    fi
    exit 0
fi

if [[ $# -eq 1 ]]; then
    target="$1"
    [[ ! -d "$target" ]] && { echo "✗ Not a directory: $target" >&2; exit 1; }

    count=0
    for item in ./* ./.[!.]* ..?*; do
        [[ -e "$item" ]] || continue
        name=$(basename "$item")
        [[ "$name" == "." || "$name" == ".." ]] && continue
        [[ -d "$item" ]] && continue
        real_item=$(realpath "$item" 2>/dev/null || echo "$item")
        real_target=$(realpath "$target" 2>/dev/null || echo "$target")
        [[ "$real_item" == "$real_target" ]] && continue
        move_item "$item" "$target/"
        ((count++)) || true
    done
    if $DRY_RUN; then
        echo "Would move $count loose file(s) into $target"
    else
        echo "✓ Moved $count loose file(s) into $target"
    fi
    exit 0
fi

[[ $# -gt 0 ]] && { usage; exit 1; }

shopt -s nullglob
dirs=(*/)
shopt -u nullglob

[[ ${#dirs[@]} -eq 0 ]] && { echo "✗ No subdirectory in current directory" >&2; exit 1; }
[[ ${#dirs[@]} -gt 1 ]] && { echo "✗ Multiple subdirectories; specify target: wrap <dir>" >&2; exit 1; }

target="${dirs[0]}"
count=0
for item in ./* ./.[!.]* ..?*; do
    [[ -e "$item" ]] || continue
    [[ -d "$item" ]] && continue
    name=$(basename "$item")
    [[ "$name" == "." || "$name" == ".." ]] && continue
    move_item "$item" "$target"
    ((count++)) || true
done
if $DRY_RUN; then
    echo "Would move $count loose file(s) into $target"
else
    echo "✓ Moved $count loose file(s) into $target"
fi
