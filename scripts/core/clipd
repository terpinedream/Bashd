#!/bin/bash
# Copy multiple files to clipboard with comment-style separators showing each file's path.
# clipd <file1> [file2] ...

usage() {
  echo "Usage: clipd <file1> [file2] ..." >&2
  echo "  Concatenates files with # /path/to/file headers and copies to clipboard" >&2
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }
[[ $# -eq 0 ]] && { usage; exit 1; }

source "$(dirname "$(readlink -f "$0")")/../_bashd_clip"

for f in "$@"; do
  [[ ! -e "$f" ]] && { echo "✗ No such file: $f" >&2; exit 1; }
  [[ ! -f "$f" ]] && { echo "✗ Not a regular file: $f" >&2; exit 1; }
  [[ ! -r "$f" ]] && { echo "✗ File is not readable: $f" >&2; exit 1; }
done

output=""
for f in "$@"; do
  abspath=$(readlink -f "$f" 2>/dev/null || realpath "$f" 2>/dev/null || echo "$f")
  [[ -n "$output" ]] && output+=$'\n'
  output+="# ${abspath}"$'\n'
  body=$(cat -- "$f"; printf x)
  output+="${body%x}"
  output+=$'\n'
done

if ! printf '%s' "$output" | bashd_clipboard_copy; then
  exit 1
fi

echo "✓ Copied $# file(s) to clipboard"
