#!/bin/bash
# Show largest files (or directories) in CWD, ranked by size.
# sized              Top 10 files
# sized -d           Top 10 directories
# sized -r           Recursive (include files in subdirs)
# sized -n N         Show top N (default 10)

usage() {
  echo "Usage: sized [-d] [-r] [-n N]" >&2
  echo "  -d   Rank directories by total size (default: files)" >&2
  echo "  -r   Recursive (include subdirectory contents)" >&2
  echo "  -n N Show top N results (default 10)" >&2
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

DIRS=false
RECURSE=false
COUNT=10

while getopts "drn:h" opt; do
  case $opt in
    d) DIRS=true ;;
    r) RECURSE=true ;;
    n) COUNT="$OPTARG" ;;
    h) usage; exit 0 ;;
    *) usage; exit 1 ;;
  esac
done
shift $((OPTIND-1))
[[ $# -gt 0 ]] && { usage; exit 1; }
[[ "$COUNT" =~ ^[0-9]+$ ]] || { echo "✗ -n requires a number" >&2; exit 1; }
[[ "$COUNT" -lt 1 ]] && { echo "✗ -n must be at least 1" >&2; exit 1; }

if $DIRS; then
  if $RECURSE; then
    du -ah --max-depth=99 . 2>/dev/null | grep -E '^\S+\s+\./' | \
      awk '$2 != "./" && $2 ~ /\/$/ || system("test -d " $2)' | \
      sort -rh | head -n "$COUNT"
  else
    results=$(du -sh ./*/ 2>/dev/null | sort -rh | head -n "$COUNT")
    if [[ -z "$results" ]]; then
      echo "No directories in CWD"
      exit 0
    fi
    echo "$results" | while IFS=$'\t' read -r size path; do
      name=$(basename "$path")
      printf '  %8s  %s/\n' "$size" "$name"
    done
  fi
else
  if $RECURSE; then
    find . -type f -print0 2>/dev/null | xargs -0 du -h 2>/dev/null | \
      sort -rh | head -n "$COUNT" | while IFS=$'\t' read -r size path; do
        printf '  %8s  %s\n' "$size" "$path"
      done
  else
    results=""
    for f in ./* ./.[!.]* ..?*; do
      [[ -f "$f" ]] || continue
      results+="$(du -h -- "$f" 2>/dev/null)"$'\n'
    done
    results=$(printf '%s' "$results" | grep -v '^$' | sort -rh | head -n "$COUNT")
    if [[ -z "$results" ]]; then
      echo "No files in CWD"
      exit 0
    fi
    echo "$results" | while IFS=$'\t' read -r size path; do
      name=$(basename "$path")
      printf '  %8s  %s\n' "$size" "$name"
    done
  fi
fi
