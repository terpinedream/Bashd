#!/bin/bash
# Create subdir from filename prefix (first delimiter). prefix_rest -> prefix/rest. One level per run.
# nest [delim]  - default delimiter _. Files with no delimiter stay in CWD.

usage() {
  printf 'Usage: nest [-n] [delimiter]\n  Create subdirs from filename prefix: prefix_rest -> prefix/rest.\n  -n  dry run\n' >&2
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

source "$(dirname "$(readlink -f "$0")")/../_bashd_files"
bashd_refuse_home_root || exit 1

DRY_RUN=false
if [[ "${1:-}" == "-n" ]]; then
  DRY_RUN=true
  shift
fi
delim="_"
[[ $# -gt 0 ]] && delim="$1"

for item in ./* ./.[!.]* ..?*; do
    [[ -e "$item" ]] || continue
    [[ -d "$item" ]] && continue
    name=$(basename "$item")
    [[ "$name" == "." || "$name" == ".." ]] && continue
    if [[ "$name" != *"$delim"* ]]; then
        continue
    fi
    prefix="${name%%"$delim"*}"
    # Strip trailing hyphen or underscore from directory name (e.g. help- -> help, my_dir_ -> my_dir)
    prefix="${prefix%-}"
    prefix="${prefix%_}"
    # Rest is the filename inside the new dir (flatten re-joins with _).
    rest="${name#*"$delim"}"
    [[ -z "$prefix" ]] && continue
    dest="$prefix/$rest"
    n=2
    while [[ -e "$dest" ]]; do
        ext="${rest##*.}"
        [[ "$rest" == "$ext" ]] && ext=""
        [[ -n "$ext" ]] && rest_noext="${rest%.*}" || rest_noext="$rest"
        [[ -n "$ext" ]] && rest_new="${rest_noext}_${n}.${ext}" || rest_new="${rest_noext}_${n}"
        dest="$prefix/$rest_new"
        ((n++)) || true
    done
    if $DRY_RUN; then
        echo "  would move $item -> $dest"
        continue
    fi
    mkdir -p "$prefix" || { echo "✗ Failed to create $prefix" >&2; exit 1; }
    if ! mv -- "$item" "$dest"; then
        echo "✗ Failed to move $item" >&2
        exit 1
    fi
done

if $DRY_RUN; then
    echo "Would nest files by first '$delim' into subdirs"
else
    echo "✓ Nested files by first '$delim' into subdirs (one level)"
fi
