#!/bin/bash
# Copy a file's contents (or stdin) to the system clipboard.
# clip <filename>     Copy file contents
# clip                Copy stdin (when piped: ls | clip)

usage() {
  echo "Usage: clip [filename]" >&2
  echo "  clip <file>   Copy file contents to clipboard" >&2
  echo "  clip          Copy stdin (e.g. ls | clip)" >&2
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

source "$(dirname "$(readlink -f "$0")")/../_bashd_clip"

if [[ $# -eq 0 ]]; then
  if [[ -t 0 ]]; then
    usage
    exit 1
  fi
  bashd_clipboard_copy || exit 1
  echo "✓ Copied stdin to clipboard"
  exit 0
fi

[[ $# -ne 1 ]] && { usage; exit 1; }
file="$1"

[[ ! -e "$file" ]] && { echo "✗ No such file: $file" >&2; exit 1; }
[[ ! -f "$file" ]] && { echo "✗ Not a regular file: $file" >&2; exit 1; }
[[ ! -r "$file" ]] && { echo "✗ File is not readable: $file" >&2; exit 1; }

bashd_clipboard_copy <"$file" || exit 1
echo "✓ Copied contents of '$file' to clipboard"
