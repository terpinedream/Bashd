#!/bin/bash
# Add prefix to loose filenames in CWD: -d date (YYYY_MM_DD), -p parent dir name, -i index.
# pfx [-d] [-p] [-i]  Flags combinable. Only regular files, direct children.

usage() {
    echo "Usage: pfx [-d] [-p] [-i]"
    echo "  -d  Prepend date (YYYY_MM_DD)"
    echo "  -p  Prepend parent directory name"
    echo "  -i  Prepend incremental index (001, 002, ...)"
    echo "  At least one flag required. Optional file args; default: all loose files in CWD."
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

DO_DATE=false
DO_PARENT=false
DO_INDEX=false
while getopts "dpih" opt; do
    case $opt in
        d) DO_DATE=true ;;
        p) DO_PARENT=true ;;
        i) DO_INDEX=true ;;
        h) usage; exit 0 ;;
        *) usage; exit 1 ;;
    esac
done
shift $((OPTIND-1))
[[ "$DO_DATE" != true ]] && [[ "$DO_PARENT" != true ]] && [[ "$DO_INDEX" != true ]] && { usage; exit 1; }

source "$(dirname "$(readlink -f "$0")")/../_bashd_log"
source "$(dirname "$(readlink -f "$0")")/../_bashd_files"

parent_name=$(basename "$(pwd)")
date_str=$(date +%Y_%m_%d)

bashd_collect_loose_files "$@" || exit 1
files=("${bashd_files[@]}")
[[ ${#files[@]} -eq 0 ]] && { echo "No files to pfx"; exit 0; }

# Sort for stable order
IFS=$'\n' read -r -d '' -a sorted < <(printf '%s\n' "${files[@]}" | sort) || true
[[ ${#sorted[@]} -eq 0 ]] && sorted=("${files[@]}")

tmp_suffix=".pfx.$$"
bashd_log_start "pfx"
i=1
# Phase 1: move to temp names
for f in "${sorted[@]}"; do
    [[ -e "$f" ]] || continue
    base=$(basename "$f")
    ext=""
    if [[ "$base" == *.* ]]; then
        ext=".${base##*.}"
        base="${base%.*}"
    fi
    newbase="$base"
    [[ "$DO_INDEX" == true ]] && newbase="$(printf '%03d' "$i")_${newbase}"
    [[ "$DO_PARENT" == true ]] && newbase="${parent_name}_${newbase}"
    [[ "$DO_DATE" == true ]] && newbase="${date_str}_${newbase}"
    newname="${newbase}${ext}"
    n=2
    while [[ -e "$newname" ]] || [[ -e "${newname}${tmp_suffix}" ]]; do
        newname="${newbase}_${n}${ext}"
        ((n++)) || true
    done
    mv -- "$f" "${newname}${tmp_suffix}" || { echo "✗ Failed to rename $f" >&2; exit 1; }
    bashd_log "$(basename "$f")" "$newname"
    ((i++))
done
# Phase 2: remove temp suffix
for item in *"${tmp_suffix}"; do
    [[ -e "$item" ]] || [[ -L "$item" ]] || continue
    final="${item%${tmp_suffix}}"
    mv -- "$item" "$final" || { echo "✗ Failed to finalize $item" >&2; exit 1; }
done
echo "✓ Prefixed ${#files[@]} file(s)"
