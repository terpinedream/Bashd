#!/bin/bash
# Move all files from subdirectories (any depth) into CWD, prefixing each filename with its path.
# flatten  - no args; a/b/file.txt -> a_b_file.txt; then remove empty dirs. Regular files only.

usage() {
  printf 'Usage: flatten [-n]\n  Move all files from subdirs into CWD, prefixing with path.\n  -n  dry run\n' >&2
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

source "$(dirname "$(readlink -f "$0")")/../_bashd_files"
bashd_refuse_home_root || exit 1

DRY_RUN=false
while getopts "nh" opt; do
  case $opt in
    n) DRY_RUN=true ;;
    h) usage; exit 0 ;;
    *) usage; exit 1 ;;
  esac
done
shift $((OPTIND-1))
[[ $# -gt 0 ]] && { usage; exit 1; }

cwd=$(pwd)
# Collect all regular files under subdirs (relative path from CWD)
files=()
while IFS= read -r -d '' f; do
    [[ -n "$f" ]] && files+=("$f")
done < <(find . -mindepth 2 -type f -print0 2>/dev/null | sort -z)

[[ ${#files[@]} -eq 0 ]] && { echo "✓ No files in subdirectories to flatten"; exit 0; }

# Build target name: path with / replaced by _
for f in "${files[@]}"; do
    base=$(basename "$f")
    dirpath=$(dirname "$f")
    prefix="${dirpath#./}"
    prefix="${prefix//\//_}"
    # Avoid double underscore: only add _ if prefix doesn't end with _ and base doesn't start with _
    if [[ "$prefix" == *_ ]] || [[ "$base" == _* ]]; then
        target="${prefix}${base}"
    else
        target="${prefix}_${base}"
    fi
    dest="$target"
    n=2
    while [[ -e "$cwd/$dest" ]]; do
        ext="${base##*.}"
        [[ "$base" == "$ext" ]] && ext=""
        [[ -n "$ext" ]] && base_noext="${base%.*}" || base_noext="$base"
        # Collision suffix: prefix_base_n (single underscores)
        [[ -n "$ext" ]] && dest="${prefix}_${base_noext}_${n}.${ext}" || dest="${prefix}_${base_noext}_${n}"
        ((n++))
    done
    if $DRY_RUN; then
        echo "  would move $f -> $dest"
        continue
    fi
    if ! mv -- "$f" "$cwd/$dest"; then
        echo "✗ Failed to move $f" >&2
        exit 1
    fi
done

if ! $DRY_RUN; then
# Remove empty directories (repeat until no change; depth-first so leaves go first)
while true; do
    removed=0
    while IFS= read -r -d '' d; do
        [[ -n "$d" ]] || continue
        if rmdir -- "$d" 2>/dev/null; then ((removed++)); fi
    done < <(find . -mindepth 1 -type d -print0 2>/dev/null | sort -rz)
    [[ $removed -eq 0 ]] && break
done
fi

if $DRY_RUN; then
    echo "Would flatten ${#files[@]} file(s) into CWD"
else
    echo "✓ Flattened ${#files[@]} file(s) into CWD and removed empty directories"
fi
