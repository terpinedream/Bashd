#!/bin/bash
# Create a directory and move into it all items in CWD whose name contains (or -w whole-word matches) the dir name.
# stick [-i] [-w] <dir_name>  -i case-insensitive, -w whole-word only. Default: substring match.

usage() {
    echo "Usage: stick [-i] [-w] <dir_name>"
    echo "  Create dir_name/ and move items whose name contains dir_name into it."
    echo "  -i  Case-insensitive match"
    echo "  -w  Whole-word only (bounded by non-alphanumeric)"
    exit 0
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

CASE_INSENSITIVE=false
WHOLE_WORD=false
DIRNAME=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -i) CASE_INSENSITIVE=true; shift ;;
        -w) WHOLE_WORD=true; shift ;;
        --) shift; DIRNAME="$1"; shift; break ;;
        -*) echo "Unknown option: $1" >&2; usage ;;
        *)  DIRNAME="$1"; shift ;;
    esac
done

[[ -z "$DIRNAME" ]] && usage

if [[ -e "$DIRNAME" ]] && [[ ! -d "$DIRNAME" ]]; then
    echo "✗ Not a directory (file exists): $DIRNAME" >&2
    exit 1
fi

mkdir -p "$DIRNAME" || { echo "✗ Failed to create $DIRNAME" >&2; exit 1; }

# Build pattern for matching: substring or whole-word
needle="$DIRNAME"
[[ "$CASE_INSENSITIVE" == true ]] && needle=$(echo "$DIRNAME" | tr '[:upper:]' '[:lower:]')

matches() {
    local name="$1"
    local n="$name"
    [[ "$CASE_INSENSITIVE" == true ]] && n=$(echo "$name" | tr '[:upper:]' '[:lower:]')
    if [[ "$WHOLE_WORD" == true ]]; then
        # Whole-word: match as substring bounded by non-alphanumeric (or start/end)
        [[ "$n" == *"$needle"* ]] || return 1
        local before after
        before="${n%%"$needle"*}"
        after="${n#*"$needle"}"
        [[ -z "$before" || "$before" =~ [^a-zA-Z0-9]$ ]] || return 1
        [[ -z "$after" || "$after" =~ ^[^a-zA-Z0-9] ]] || return 1
        return 0
    fi
    [[ "$n" == *"$needle"* ]]
}

count=0
for item in ./* ./.[!.]* ..?*; do
    [[ -e "$item" ]] || continue
    name=$(basename "$item")
    [[ "$name" == "." || "$name" == ".." ]] && continue
    [[ "$name" == "$DIRNAME" ]] && continue
    if matches "$name"; then
        if ! mv -- "$item" "$DIRNAME/"; then
            echo "✗ Failed to move $item" >&2
            exit 1
        fi
        ((count++))
    fi
done

echo "✓ Created $DIRNAME/ and moved $count item(s) into it"
