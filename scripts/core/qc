#!/bin/bash
# Quick interactive file/dir deletion in CWD. Lists items, lets you pick which to delete.
# qc              List all items in CWD, pick numbers to delete
# qc <pattern>    Filter by case-insensitive substring first, then pick

usage() {
    echo "Usage: qc [pattern]" >&2
    echo "  qc            List all items in CWD and pick to delete" >&2
    echo "  qc <pattern>  Filter items by substring first" >&2
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

source "$(dirname "$(readlink -f "$0")")/../_bashd_files"
bashd_refuse_home_root || exit 1

pattern="${1:-}"

items=()
for item in ./* ./.[!.]* ..?*; do
    [[ -e "$item" ]] || continue
    name=$(basename "$item")
    [[ "$name" == "." || "$name" == ".." ]] && continue
    if [[ -n "$pattern" ]]; then
        lower_name="${name,,}"
        lower_pat="${pattern,,}"
        [[ "$lower_name" != *"$lower_pat"* ]] && continue
    fi
    items+=("$item")
done

if [[ ${#items[@]} -eq 0 ]]; then
    if [[ -n "$pattern" ]]; then
        echo "No items matching '$pattern' in CWD."
    else
        echo "No items in CWD."
    fi
    exit 0
fi

echo "Items in CWD${pattern:+ matching '$pattern'}:"
for i in "${!items[@]}"; do
    name=$(basename "${items[$i]}")
    if [[ -d "${items[$i]}" ]]; then
        printf "  %d. %s/\n" "$((i+1))" "$name"
    else
        printf "  %d. %s\n" "$((i+1))" "$name"
    fi
done
echo ""
echo "Enter numbers to delete (space-separated), a = all, 0 = cancel"
read -r -p "> " ans

reply=$(echo "$ans" | tr -s '[:space:]' ' ')
case "$reply" in
    ""|0)
        echo "Cancelled."
        exit 0
        ;;
    [aA])
        selected=("${items[@]}")
        ;;
    *)
        selected=()
        for word in $reply; do
            if [[ "$word" =~ ^[0-9]+$ ]] && [[ "$word" -ge 1 ]] && [[ "$word" -le ${#items[@]} ]]; then
                selected+=("${items[$((word-1))]}")
            else
                echo "✗ Invalid number: $word (skipping)" >&2
            fi
        done
        [[ ${#selected[@]} -eq 0 ]] && { echo "Nothing selected."; exit 0; }
        ;;
esac

echo ""
echo "Will delete ${#selected[@]} item(s):"
for s in "${selected[@]}"; do
    printf "  %s\n" "$(basename "$s")"
done
read -r -p "Confirm? [y/N] " confirm
[[ "$confirm" =~ ^[yY] ]] || { echo "Aborted."; exit 0; }

deleted=0
for s in "${selected[@]}"; do
    if [[ -d "$s" ]]; then
        rm -rf -- "$s" 2>/dev/null && ((deleted++)) || echo "✗ Failed to remove $s" >&2
    else
        rm -f -- "$s" 2>/dev/null && ((deleted++)) || echo "✗ Failed to remove $s" >&2
    fi
done
echo "✓ Deleted $deleted item(s)"
