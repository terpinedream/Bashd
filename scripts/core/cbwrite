#!/bin/bash
# Write clipboard contents to a file (inverse of clip).
# cbwrite <filename>       Write clipboard to file (refuse if exists)
# cbwrite -f <filename>    Overwrite if exists
# cbwrite -a <filename>    Append to file

usage() {
  echo "Usage: cbwrite [-f|-a] <filename>" >&2
  echo "  -f  Overwrite if file exists" >&2
  echo "  -a  Append to file" >&2
  echo "  Default: refuse if file already exists" >&2
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

MODE="create"
while getopts "fah" opt; do
  case $opt in
    f) MODE="overwrite" ;;
    a) MODE="append" ;;
    h) usage; exit 0 ;;
    *) usage; exit 1 ;;
  esac
done
shift $((OPTIND-1))

[[ $# -ne 1 ]] && { usage; exit 1; }
file="$1"

if [[ "$MODE" == "create" && -e "$file" ]]; then
  echo "✗ File already exists: $file (use -f to overwrite or -a to append)" >&2
  exit 1
fi

source "$(dirname "$(readlink -f "$0")")/../_bashd_clip"

content=$(bashd_clipboard_paste) || exit 1
[[ -z "$content" ]] && { echo "✗ Clipboard is empty" >&2; exit 1; }

if [[ "$MODE" == "append" ]]; then
  printf '%s\n' "$content" >> "$file" || { echo "✗ Failed to append to $file" >&2; exit 1; }
else
  printf '%s\n' "$content" > "$file" || { echo "✗ Failed to write $file" >&2; exit 1; }
fi

lines=$(printf '%s\n' "$content" | wc -l)
echo "✓ ${MODE^}: $lines line(s) → $file"
