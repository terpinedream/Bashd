#!/bin/bash
# Copy the path of CWD or a specified file/dir to the clipboard.
# Usage: cpath [file_or_dir]
#   No arg: copy current directory path. With arg: copy that path (resolved to absolute).

usage() {
  echo "Usage: cpath [file_or_dir]" >&2
  echo "  No arg: copy CWD path to clipboard" >&2
  echo "  With arg: copy the path of that file or directory (absolute)" >&2
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

[[ $# -gt 1 ]] && { usage; exit 1; }

if [[ $# -eq 0 ]]; then
  path=$(pwd)
  realpath . &>/dev/null && path=$(realpath .)
else
  target="$1"
  [[ ! -e "$target" ]] && { echo "✗ No such file or directory: $target" >&2; exit 1; }
  if realpath "$target" &>/dev/null; then
    path=$(realpath "$target")
  else
    path=$(cd "$(dirname "$target")" 2>/dev/null && pwd)/$(basename "$target")
  fi
fi

source "$(dirname "$(readlink -f "$0")")/../_bashd_clip"

printf '%s' "$path" | bashd_clipboard_copy || exit 1

if [[ $# -eq 0 ]]; then
  echo "✓ Copied CWD path to clipboard"
else
  echo "✓ Copied path to clipboard"
fi
