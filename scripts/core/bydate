#!/bin/bash
# Move loose files in CWD into date subdirs by mtime. -M = YYYY/MM, default = YYYY/MM/DD.
# bydate [-M]  Only regular files, direct children. Creates dirs as needed.

usage() {
  echo "Usage: bydate [-M] [-n]" >&2
  echo "  Moves each loose file into a directory by its modification date." >&2
  echo "  Default: YYYY/MM/DD (e.g. 2025/02/16/file.txt)" >&2
  echo "  -M  Month only: YYYY/MM" >&2
  echo "  -n  dry run" >&2
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

source "$(dirname "$(readlink -f "$0")")/../_bashd_files"
bashd_refuse_home_root || exit 1

MONTH_ONLY=false
DRY_RUN=false
while getopts "Mnh" opt; do
  case $opt in
    M) MONTH_ONLY=true ;;
    n) DRY_RUN=true ;;
    h) usage; exit 0 ;;
    *) usage; exit 1 ;;
  esac
done
shift $((OPTIND-1))
[[ $# -gt 0 ]] && { usage; exit 1; }

files=()
for item in ./* ./.[!.]* ..?*; do
  [[ -e "$item" ]] || continue
  [[ -f "$item" ]] || continue
  name=$(basename "$item")
  [[ "$name" == "." || "$name" == ".." ]] && continue
  files+=("$item")
done
[[ ${#files[@]} -eq 0 ]] && { echo "No files to organize"; exit 0; }

# Get YYYY-MM-DD from file mtime (GNU date -r)
get_date() {
  date -r "$1" +%Y-%m-%d 2>/dev/null
}

count=0
for f in "${files[@]}"; do
  [[ -e "$f" ]] || continue
  mtime=$(get_date "$f")
  [[ -z "$mtime" ]] && { echo "✗ Could not get date for $f" >&2; continue; }
  if [[ "$MONTH_ONLY" == true ]]; then
    dir="${mtime%-*}"
    dir="${dir//-/\/}"
  else
    dir="${mtime//-/\/}"
  fi
  if $DRY_RUN; then
    echo "  would move $f -> $dir/"
  else
    mkdir -p "$dir" || { echo "✗ Failed to create $dir" >&2; exit 1; }
    mv -- "$f" "$dir/" || { echo "✗ Failed to move $f" >&2; exit 1; }
  fi
  ((count++)) || true
done
if $DRY_RUN; then
  echo "Would move $count file(s) into date dirs"
else
  echo "✓ Moved $count file(s) into date dirs"
fi
