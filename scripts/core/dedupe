#!/bin/bash
# Find duplicate files by content hash; keep first in place, move rest to _dupes/ with disambiguated names.
# dedupe [-r]  -r recurse into subdirs. Uses sha256sum or shasum -a 256.

usage() {
  printf 'Usage: dedupe [-r]\n  Find duplicate files by hash; keep first, move rest to _dupes/.\n  -r  recurse into subdirectories\n' >&2
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

source "$(dirname "$(readlink -f "$0")")/../_bashd_files"
bashd_refuse_home_root || exit 1

RECURSE=false
while getopts "rh" opt; do
    case $opt in
        r) RECURSE=true ;;
        h) usage; exit 0 ;;
        *) usage; exit 1 ;;
    esac
done
shift $((OPTIND-1))
[[ $# -gt 0 ]] && { usage; exit 1; }

if command -v sha256sum &>/dev/null; then
    HASH_CMD="sha256sum"
elif command -v shasum &>/dev/null; then
    HASH_CMD="shasum -a 256"
else
    echo "✗ Need sha256sum or shasum" >&2
    exit 1
fi

cwd=$(pwd)
if [[ "$RECURSE" == true ]]; then
    find_args=(. -type f -not -path './_dupes/*')
else
    find_args=(. -maxdepth 1 -type f)
fi

# Collect hashes: hash -> list of paths (relative to CWD)
declare -A hash_to_paths
while IFS= read -r -d '' f; do
    [[ -n "$f" ]] || continue
    h=$($HASH_CMD "$f" 2>/dev/null | awk '{print $1}')
    [[ -n "$h" ]] || continue
    hash_to_paths[$h]+="${f}"$'\n'
done < <(find "${find_args[@]}" -print0 2>/dev/null | sort -z)

# For each hash with more than one file: keep first, move rest to _dupes/
dup_count=0
for h in "${!hash_to_paths[@]}"; do
    IFS=$'\n' read -r -d '' -a paths <<< "${hash_to_paths[$h]}"
    unset IFS
    [[ ${#paths[@]} -gt 1 ]] || continue
    mkdir -p "$cwd/_dupes" || { echo "✗ Failed to create _dupes/" >&2; exit 1; }
    # Sort for stable "first" file
    first=""
    for p in "${paths[@]}"; do
        [[ -n "$p" ]] || continue
        if [[ -z "$first" ]]; then
            first="$p"
            continue
        fi
        base=$(basename "$p")
        dest="$cwd/_dupes/$base"
        n=2
        while [[ -e "$dest" ]]; do
            ext="${base##*.}"
            [[ "$base" == "$ext" ]] && ext=""
            [[ -n "$ext" ]] && base_noext="${base%.*}" || base_noext="$base"
            [[ -n "$ext" ]] && dest="$cwd/_dupes/${base_noext}_${n}.${ext}" || dest="$cwd/_dupes/${base_noext}_${n}"
            ((n++))
        done
        if ! mv -- "$p" "$dest"; then
            echo "✗ Failed to move $p" >&2
            exit 1
        fi
        ((dup_count++))
    done
done

if [[ $dup_count -eq 0 ]]; then
    echo "✓ No duplicates found"
else
    echo "✓ Moved $dup_count duplicate(s) to _dupes/"
fi
