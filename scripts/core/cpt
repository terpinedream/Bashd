#!/bin/bash
# Copy the output of the last terminal command to the clipboard.
# Reads the last command saved by bashd-init.sh's PROMPT_COMMAND hook,
# shows it, and re-runs it with output captured to clipboard.
# Requires: source bashd-init.sh (saves last command to $BASHD_LAST_CMD_FILE)
# cpt        Show last command and ask before re-running
# cpt -y     Re-run without asking

usage() {
    echo "Usage: cpt [-y]" >&2
    echo "  Copies the output of the last command to clipboard" >&2
    echo "  -y  Skip confirmation (re-run immediately)" >&2
    echo "  Requires bashd-init.sh to be sourced." >&2
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

SKIP_CONFIRM=false
while getopts "yh" opt; do
    case $opt in
        y) SKIP_CONFIRM=true ;;
        h) usage; exit 0 ;;
        *) usage; exit 1 ;;
    esac
done

source "$(dirname "$(readlink -f "$0")")/../_bashd_clip"

cmd_file="${BASHD_LAST_CMD_FILE:-/tmp/bashd_lastcmd_$PPID}"

if [[ ! -f "$cmd_file" ]]; then
    echo "✗ No saved command found. Make sure bashd-init.sh is sourced." >&2
    exit 1
fi

last_cmd=$(<"$cmd_file")

if [[ -z "$last_cmd" ]]; then
    echo "✗ Last command is empty" >&2
    exit 1
fi

if ! $SKIP_CONFIRM; then
    echo "Last command:"
    echo "  $ $last_cmd"
    echo ""
    read -r -p "Re-run and copy output to clipboard? [y/N] " ans
    [[ "$ans" =~ ^[yY] ]] || { echo "Aborted."; exit 0; }
fi

output=$(eval "$last_cmd" 2>&1)
printf '%s' "$output" | bashd_clipboard_copy || exit 1
lines=$(printf '%s\n' "$output" | wc -l)
echo "✓ Copied output ($lines line(s)) to clipboard"
