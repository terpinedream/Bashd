#!/bin/bash
# Unpack directories in CWD: move their contents up into CWD and remove the empty dirs.
# uwrap                    -> unpack all directories in CWD
# uwrap path/to/dir        -> unpack only that directory (if in CWD: move; if outside CWD: copy to CWD)

usage() {
  printf 'Usage: uwrap [dir]\n  Unpack directories: uwrap = all in CWD; uwrap <dir> = specific dir.\n' >&2
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

cwd=$(pwd)
cwd_real=$(realpath "$cwd" 2>/dev/null || echo "$cwd")

unpack_one() {
    local dir="$1"
    local do_copy="${2:-false}"
    local count=0
    local dirbase
    dirbase=$(basename "$dir")
    [[ -d "$dir" ]] || return 1
    for item in "$dir"/* "$dir"/.[!.]* "$dir"/..?*; do
        [[ -e "$item" ]] || continue
        name=$(basename "$item")
        [[ "$name" == "." || "$name" == ".." ]] && continue
        # Use dirbase_name so multiple dirs with same filename don't overwrite (e.g. 1/_new.txt -> 1_new.txt)
        base="$name"
        ext=""
        [[ "$base" == *.* ]] && { ext=".${base##*.}"; base="${base%.*}"; }
        if [[ "$dirbase" == *_ ]] || [[ "$base" == _* ]]; then
            dest="$cwd/${dirbase}${base}${ext}"
        else
            dest="$cwd/${dirbase}_${base}${ext}"
        fi
        n=2
        while [[ -e "$dest" ]]; do
            [[ -n "$ext" ]] && dest="$cwd/${dirbase}_${base}_${n}${ext}" || dest="$cwd/${dirbase}_${base}_${n}"
            ((n++))
        done
        if [[ "$do_copy" == true ]]; then
            cp -r -- "$item" "$dest" || { echo "✗ Failed to copy $item"; return 1; }
        else
            mv -- "$item" "$dest" || { echo "✗ Failed to move $item"; return 1; }
        fi
        ((count++))
    done
    if [[ "$do_copy" != true ]]; then
        rmdir -- "$dir" 2>/dev/null || true
    fi
    echo "$count"
}

if [[ $# -eq 0 ]]; then
    # Unpack all directories in CWD (collect list first so we don't iterate over changing dir)
    dirs=()
    for item in ./* ./.[!.]* ..?*; do
        [[ -e "$item" ]] || continue
        [[ -d "$item" ]] || continue
        name=$(basename "$item")
        [[ "$name" == "." || "$name" == ".." ]] && continue
        dirs+=("$item")
    done
    count_total=0
    for item in "${dirs[@]}"; do
        [[ -d "$item" ]] || continue
        n=$(unpack_one "$item" false)
        count_total=$((count_total + n))
    done
    echo "✓ Unpacked all directories ($count_total item(s) moved into CWD)"
    exit 0
fi

# Unpack the specified directory (allow -- so paths like -my-dir work)
[[ "$1" == "--" ]] && shift
target="$1"
if [[ ! -d "$target" ]]; then
    echo "✗ Not a directory: $target"
    exit 1
fi

target_real=$(realpath "$target" 2>/dev/null || echo "$(cd "$(dirname "$target")" 2>/dev/null && pwd)/$(basename "$target")")
if [[ "$target_real" == "$cwd_real" ]]; then
    echo "✗ Cannot unpack current directory (.)"
    exit 1
fi
# If target is under CWD, we move. Otherwise we copy to CWD.
if [[ "$target_real" == "$cwd_real"* ]]; then
    # Target is inside CWD: unpack (move) and remove the dir
    n=$(unpack_one "$target" false)
    echo "✓ Unpacked $target ($n item(s) moved into CWD)"
else
    # Target is outside CWD: copy contents to CWD
    n=$(unpack_one "$target" true)
    echo "✓ Copied contents of $target to CWD ($n item(s))"
fi
