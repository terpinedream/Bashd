#!/bin/bash
# Batch rename loose files in CWD to a target case. Splits on _ - space and camelCase boundaries.
# recase <-c|-l|-u|-t|-k>  Exactly one flag required. Only regular files, direct children.

usage() {
  echo "Usage: recase <-c|-l|-u|-t|-k>" >&2
  echo "  -c  camelCase   (myCoolPhoto.jpg)" >&2
  echo "  -l  lowercase   (my_cool_photo.jpg)" >&2
  echo "  -u  UPPERCASE   (MY_COOL_PHOTO.jpg)" >&2
  echo "  -t  Title_Case  (My_Cool_Photo.jpg)" >&2
  echo "  -k  kebab-case  (my-cool-photo.jpg)" >&2
  echo "  Exactly one flag required. Optional file args; default: all loose files in CWD." >&2
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

MODE=""
while getopts "clutkh" opt; do
  case $opt in
    c) [[ -n "$MODE" ]] && { echo "✗ Exactly one flag required" >&2; usage; exit 1; }; MODE="camel" ;;
    l) [[ -n "$MODE" ]] && { echo "✗ Exactly one flag required" >&2; usage; exit 1; }; MODE="lower" ;;
    u) [[ -n "$MODE" ]] && { echo "✗ Exactly one flag required" >&2; usage; exit 1; }; MODE="upper" ;;
    t) [[ -n "$MODE" ]] && { echo "✗ Exactly one flag required" >&2; usage; exit 1; }; MODE="title" ;;
    k) [[ -n "$MODE" ]] && { echo "✗ Exactly one flag required" >&2; usage; exit 1; }; MODE="kebab" ;;
    h) usage; exit 0 ;;
    *) usage; exit 1 ;;
  esac
done
shift $((OPTIND-1))
[[ -z "$MODE" ]] && { usage; exit 1; }

source "$(dirname "$(readlink -f "$0")")/../_bashd_log"
source "$(dirname "$(readlink -f "$0")")/../_bashd_files"

to_words() {
  local s="$1"
  s=$(printf '%s\n' "$s" | sed 's/\([a-z0-9]\)\([A-Z]\)/\1 \2/g')
  s="${s//_/ }"
  s="${s//-/ }"
  printf '%s' "$s"
}

recase_name() {
  local input="$1" result="" first=true w
  local words
  words=$(to_words "$input")

  for word in $words; do
    [[ -z "$word" ]] && continue
    w="${word,,}"
    case "$MODE" in
      upper) w="${word^^}" ;;
      title) w="${w^}" ;;
      camel)
        if $first; then
          first=false
        else
          w="${w^}"
        fi
        ;;
    esac
    case "$MODE" in
      camel) result="${result}${w}" ;;
      kebab) result="${result:+${result}-}${w}" ;;
      *)     result="${result:+${result}_}${w}" ;;
    esac
  done
  printf '%s' "$result"
}

bashd_collect_loose_files "$@" || exit 1
files=("${bashd_files[@]}")
[[ ${#files[@]} -eq 0 ]] && { echo "No files to rename"; exit 0; }

IFS=$'\n' read -r -d '' -a sorted < <(printf '%s\n' "${files[@]}" | sort) || true
[[ ${#sorted[@]} -eq 0 ]] && sorted=("${files[@]}")

tmp_suffix=".recase.$$"
bashd_log_start "recase"
renamed=0
for f in "${sorted[@]}"; do
  [[ -e "$f" ]] || continue
  base=$(basename "$f")
  ext=""
  if [[ "$base" == *.* ]]; then
    ext=".${base##*.}"
    base="${base%.*}"
  fi

  newbase=$(recase_name "$base")
  [[ -z "$newbase" ]] && continue

  ext="${ext,,}"

  newname="${newbase}${ext}"
  [[ "$newname" == "$(basename "$f")" ]] && continue

  n=2
  while [[ -e "$newname" ]] || [[ -e "${newname}${tmp_suffix}" ]]; do
    newname="${newbase}_${n}${ext}"
    ((n++))
  done
  mv -- "$f" "${newname}${tmp_suffix}" || { echo "✗ Failed to rename $f" >&2; exit 1; }
  bashd_log "$(basename "$f")" "$newname"
  ((renamed++))
done

for item in *"${tmp_suffix}"; do
  [[ -e "$item" ]] || [[ -L "$item" ]] || continue
  final="${item%${tmp_suffix}}"
  mv -- "$item" "$final" || { echo "✗ Failed to finalize $item" >&2; exit 1; }
done

[[ $renamed -eq 0 ]] && { echo "No files needed recasing"; exit 0; }
echo "✓ Recased $renamed file(s) to $MODE"
