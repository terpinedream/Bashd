#!/bin/bash
# Helper script to reverse the last pacman update
# Downgrades packages updated in the last transaction using cached .pkg files.
# Requires root. Skips packages not found in cache.

CACHE_DIR="/var/cache/pacman/pkg"
LOG="/var/log/pacman.log"

if [[ $EUID -ne 0 ]]; then
    echo "pacdown must be run as root (e.g. sudo pacdown)"
    exit 1
fi

# Find last "synchronizing package list" line number, then get upgraded packages after it
last_sync_line=$(grep -n 'synchronizing package list' "$LOG" 2>/dev/null | tail -1 | cut -d: -f1)
if [[ -z "$last_sync_line" ]]; then
    echo "✗ Could not find last sync in $LOG"
    exit 1
fi

# Upgraded packages in the last transaction (after last sync)
upgraded=$(sed -n "${last_sync_line},\$p" "$LOG" | grep -E '\[ALPM\] upgraded ' | awk '{print $NF}' | sort -u)
if [[ -z "$upgraded" ]]; then
    echo "No upgraded packages in last transaction to downgrade"
    exit 0
fi

missing=()
to_downgrade=()

for pkg in $upgraded; do
    # Match .pkg.tar.zst or .pkg.tar.xz for this package (any version in cache)
    cand=$(find "$CACHE_DIR" -maxdepth 1 \( -name "${pkg}-[0-9]*.pkg.tar.zst" -o -name "${pkg}-[0-9]*.pkg.tar.xz" \) 2>/dev/null | head -1)
    if [[ -n "$cand" ]]; then
        to_downgrade+=("$cand")
    else
        missing+=("$pkg")
    fi
done

if [[ ${#missing[@]} -gt 0 ]]; then
    echo "Packages not in cache (skipped): ${missing[*]}"
fi

if [[ ${#to_downgrade[@]} -eq 0 ]]; then
    echo "✗ No cached packages to downgrade"
    exit 1
fi

echo "Downgrading ${#to_downgrade[@]} package(s) from cache..."
if pacman -U --noconfirm "${to_downgrade[@]}"; then
    echo "✓ Downgrade completed"
else
    echo "✗ Downgrade failed"
    exit 1
fi
