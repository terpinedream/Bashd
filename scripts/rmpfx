#!/bin/bash
# Remove prefix from filenames at delimiter. prefix_rest.ext -> rest.ext. Files without enough
# delimiter segments are skipped. rmpfx [-n N] [delim]  Default: strip 1 segment, delimiter _.

usage() {
  echo "Usage: rmpfx [-n N] [delim]" >&2
  echo "  -n N   Strip N prefix segments (default 1)" >&2
  echo "  delim  Delimiter character (default _)" >&2
  echo "  Files with fewer segments than N are skipped." >&2
  exit 1
}

COUNT=1
while getopts "n:" opt; do
  case $opt in
    n) COUNT="$OPTARG" ;;
    *) usage ;;
  esac
done
shift $((OPTIND-1))

delim="_"
[[ $# -gt 1 ]] && usage
[[ $# -eq 1 ]] && delim="$1"
[[ "$COUNT" =~ ^[1-9][0-9]*$ ]] || { echo "✗ -n must be a positive integer" >&2; exit 1; }

source "$(dirname "$(readlink -f "$0")")/_bashd_log"

files=()
for item in ./* ./.[!.]* ..?*; do
  [[ -e "$item" ]] || continue
  [[ -f "$item" ]] || continue
  name=$(basename "$item")
  [[ "$name" == "." || "$name" == ".." ]] && continue
  files+=("$item")
done
[[ ${#files[@]} -eq 0 ]] && { echo "No files to rename"; exit 0; }

IFS=$'\n' read -r -d '' -a sorted < <(printf '%s\n' "${files[@]}" | sort) || true
[[ ${#sorted[@]} -eq 0 ]] && sorted=("${files[@]}")

tmp_suffix=".rmpfx.$$"
bashd_log_start "rmpfx"
renamed=0
for f in "${sorted[@]}"; do
  [[ -e "$f" ]] || continue
  base=$(basename "$f")
  ext=""
  if [[ "$base" == *.* ]]; then
    ext=".${base##*.}"
    base="${base%.*}"
  fi

  rest="$base"
  for ((j = 0; j < COUNT; j++)); do
    [[ "$rest" != *"$delim"* ]] && { rest=""; break; }
    rest="${rest#*"$delim"}"
  done
  [[ -z "$rest" ]] && continue

  newname="${rest}${ext}"
  [[ "$newname" == "$(basename "$f")" ]] && continue

  n=2
  while [[ -e "$newname" ]] || [[ -e "${newname}${tmp_suffix}" ]]; do
    newname="${rest}_${n}${ext}"
    ((n++))
  done
  mv -- "$f" "${newname}${tmp_suffix}" || { echo "✗ Failed to rename $f" >&2; exit 1; }
  bashd_log "$(basename "$f")" "$newname"
  ((renamed++))
done

for item in *"${tmp_suffix}"; do
  [[ -e "$item" ]] || [[ -L "$item" ]] || continue
  final="${item%${tmp_suffix}}"
  mv -- "$item" "$final" || { echo "✗ Failed to finalize $item" >&2; exit 1; }
done

[[ $renamed -eq 0 ]] && { echo "No files matched (need at least $COUNT delimiter segment(s))"; exit 0; }
echo "✓ Stripped prefix from $renamed file(s)"
