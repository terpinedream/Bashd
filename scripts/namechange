#!/bin/bash
# Script to mass rename files: number as prefix, underscore separator (works with nest).
# namechange "file.txt" -> 1_file.txt, 2_file.txt, ...  Ignores directories.

if [[ $# -lt 1 ]]; then
    echo "Usage: namechange [--] <template>"
    echo "  Example: namechange \"file.txt\" -> 1_file.txt, 2_file.txt, ... (underscore separator for nest)"
    exit 1
fi
[[ "$1" == "--" ]] && shift
[[ $# -ne 1 ]] && { echo "Usage: namechange [--] <template>" >&2; exit 1; }
template="$1"
base="${template%.*}"
ext=""
[[ "$template" == *.* ]] && ext=".${template##*.}"

if [[ -z "$base" ]]; then
    base="file"
fi

# Collect regular files only, sorted for stable order
files=()
while IFS= read -r -d '' f; do
    [[ -n "$f" ]] && files+=("$f")
done < <(find . -maxdepth 1 -type f -printf '%P\0' 2>/dev/null | sort -z)

[[ ${#files[@]} -eq 0 ]] && { echo "No files to rename"; exit 0; }

# Two-phase rename: N_base.ext (underscore separator for nest synergy)
tmp_suffix=".cleanme.$$"
i=1
for f in "${files[@]}"; do
    newname="${i}_${base}${ext}"
    tmpname="${i}_${base}${ext}${tmp_suffix}"
    if ! mv -- "$f" "$tmpname"; then
        echo "✗ Failed to rename $f"
        exit 1
    fi
    ((i++))
done

i=1
for f in "${files[@]}"; do
    tmpname="${i}_${base}${ext}${tmp_suffix}"
    newname="${i}_${base}${ext}"
    mv -- "$tmpname" "$newname"
    ((i++))
done

echo "✓ Renamed ${#files[@]} file(s) to N_${base}${ext}"
