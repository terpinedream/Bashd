#!/bin/bash
# Create a new directory in CWD and move loose items into it.
# fold newDirectory     -> create newDirectory/, move only files (ignore directories)
# fold -a newDirectory  -> create newDirectory/, move files and directories

if [[ $# -lt 1 ]]; then
    echo "Usage: fold [-a|--all] <directory_name>"
    echo "  Creates directory_name/ in CWD and moves loose items into it."
    echo "  Default: move only files (ignore directories)"
    echo "  -a, --all  Move files and directories"
    exit 1
fi

ALL=false
DIRNAME=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -a|--all)
            ALL=true
            shift
            ;;
        -*)
            echo "Unknown option: $1"
            exit 1
            ;;
        *)
            DIRNAME="$1"
            shift
            ;;
    esac
done

[[ -z "$DIRNAME" ]] && { echo "Usage: fold [-a|--all] <directory_name>"; exit 1; }

if [[ -e "$DIRNAME" ]]; then
    echo "✗ Already exists: $DIRNAME"
    exit 1
fi

mkdir -p "$DIRNAME" || { echo "✗ Failed to create $DIRNAME"; exit 1; }

count=0
for item in ./* ./.[!.]* ..?*; do
    [[ -e "$item" ]] || continue
    name=$(basename "$item")
    [[ "$name" == "." || "$name" == ".." ]] && continue
    [[ "$name" == "$DIRNAME" ]] && continue
    if [[ "$ALL" != true ]] && [[ -d "$item" ]]; then
        continue
    fi
    if ! mv "$item" "$DIRNAME/"; then
        echo "✗ Failed to move $item"
        exit 1
    fi
    ((count++))
done

echo "✓ Created $DIRNAME/ and moved $count item(s) into it"
