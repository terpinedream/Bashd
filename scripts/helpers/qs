#!/usr/bin/env bash
# quickSearch (qs) - quickly navigate files and directories in the shell

set -e

HOME="${HOME:-$HOME}"
EDITOR="${EDITOR:-${VISUAL:-nano}}"

# Common directories (numbered 1 to n; 0 = cancel)
DIRS=(
  "$HOME"
  "$HOME/Documents"
  "$HOME/Downloads"
  "$HOME/Desktop"
  "$HOME/Music"
  "$HOME/Pictures"
  "$HOME/Videos"
  "$HOME/.config"
)

# Page size: keys [2]-[8] = 7 subdirs, [9] = show more
PAGE_SIZE=7

# Show contents of current_dir: [0] Done, [1] .. (parent), [2]-[8] subdirs, [9] More (if more). Echo chosen path and return.
drill_down() {
  local current_dir="$1"
  local parent key offset=0
  local -a subdirs

  while true; do
    parent="$(dirname "$current_dir")"
    subdirs=()
    while IFS= read -r path; do
      [[ -z "$path" ]] && continue
      subdirs+=("$path")
    done < <(find "$current_dir" -maxdepth 1 -type d ! -path "$current_dir" 2>/dev/null | sort)
    local total=${#subdirs[@]}

    echo "" >&2
    echo "In: $current_dir" >&2
    echo "  [0] Done (use this directory)" >&2
    echo "  [1] .. (parent)" >&2
    local i
    for (( i = 0; i < PAGE_SIZE && (offset + i) < total; i++ )); do
      printf "  [%d] %s\n" "$(( i + 2 ))" "$(basename "${subdirs[offset + i]}")" >&2
    done
    if (( offset > 0 )); then
      echo "  [b] Back (previous page)" >&2
    fi
    if (( offset + PAGE_SIZE < total )); then
      echo "  [9] More ($(( total - offset - PAGE_SIZE )) more)" >&2
    fi
    echo "" >&2
    printf "Choice: " >&2
    read -n 1 -s key
    echo "" >&2

    if [[ "$key" == "0" ]]; then
      echo "$current_dir"
      return 0
    fi
    if [[ "$key" == "1" ]]; then
      [[ "$current_dir" == "/" ]] && continue
      current_dir="$parent"
      offset=0
      continue
    fi
    if [[ "$key" == "b" || "$key" == "B" ]]; then
      if (( offset > 0 )); then
        offset=$(( offset - PAGE_SIZE ))
        [[ $offset -lt 0 ]] && offset=0
        continue
      fi
      echo "Unknown choice." >&2
      continue
    fi
    if [[ "$key" == "9" ]]; then
      if (( offset + PAGE_SIZE < total )); then
        (( offset += PAGE_SIZE ))
        continue
      fi
      echo "Unknown choice." >&2
      continue
    fi
    if [[ "$key" =~ ^[2-8]$ ]]; then
      local idx=$(( (key - 2) + offset ))
      if (( idx < total )); then
        current_dir="${subdirs[idx]}"
        offset=0
        continue
      fi
      echo "Unknown choice." >&2
    else
      echo "Unknown choice. Use 0-9" >&2
    fi
  done
}

list_common_dirs() {
  echo "quickSearch — pick a directory (1-${#DIRS[@]}), 0 = cancel. No Enter needed." >&2
  echo "" >&2
  local i
  for i in $(seq 1 ${#DIRS[@]}); do
    printf "  [%d] %s\n" "$i" "${DIRS[$i-1]}" >&2
  done
  echo "" >&2
  printf "Choice: " >&2

  read -n 1 -s key
  echo "" >&2

  if [[ "$key" == "0" ]]; then
    echo "Cancelled." >&2
    return 1
  fi
  if [[ "$key" =~ ^[1-9]$ ]] && [[ "$key" -ge 1 ]] && [[ "$key" -le ${#DIRS[@]} ]]; then
    # Enter drill-down with chosen dir
    drill_down "${DIRS[$((key-1))]}"
  else
    echo "Unknown choice. Use 0-${#DIRS[@]}" >&2
    return 1
  fi
}

search_dirs() {
  local pattern="$1"
  if [[ -z "$pattern" ]]; then
    echo "Usage: qs -s NAMEOFDIR" >&2
    return 1
  fi

  local -a matches
  while IFS= read -r path; do
    matches+=("$path")
  done < <(find "$HOME" -maxdepth 4 -type d -iname "*${pattern}*" 2>/dev/null | head -50)

  if [[ ${#matches[@]} -eq 0 ]]; then
    echo "No directories matching '${pattern}'" >&2
    return 1
  fi

  echo "Directories matching '${pattern}':" >&2
  local i
  for i in "${!matches[@]}"; do
    echo "  [$i] ${matches[$i]}" >&2
  done
  echo "" >&2
  printf "Pick number (0-%d): " $(( ${#matches[@]} - 1 )) >&2
  read -r num
  if [[ "$num" =~ ^[0-9]+$ ]] && [[ "$num" -ge 0 ]] && [[ "$num" -lt ${#matches[@]} ]]; then
    echo "${matches[$num]}"
  else
    echo "Invalid choice." >&2
    return 1
  fi
}

search_file() {
  local pattern="$1"
  if [[ -z "$pattern" ]]; then
    echo "Usage: qs -f NAMEOFFILE.EXT" >&2
    return 1
  fi

  local -a matches
  while IFS= read -r path; do
    matches+=("$path")
  done < <(find "$HOME" -maxdepth 6 -type f -iname "*${pattern}*" 2>/dev/null | head -50)

  if [[ ${#matches[@]} -eq 0 ]]; then
    echo "No files matching '${pattern}'" >&2
    return 1
  fi

  echo "Files matching '${pattern}':" >&2
  local i
  for i in "${!matches[@]}"; do
    echo "  [$i] ${matches[$i]}" >&2
  done
  echo "" >&2
  printf "Pick number (0-%d): " $(( ${#matches[@]} - 1 )) >&2
  read -r num
  if [[ "$num" =~ ^[0-9]+$ ]] && [[ "$num" -ge 0 ]] && [[ "$num" -lt ${#matches[@]} ]]; then
    "$EDITOR" "${matches[$num]}" </dev/tty >/dev/tty 2>&1
  else
    echo "Invalid choice." >&2
    return 1
  fi
}

usage() {
  echo "qs — quickSearch" >&2
  echo "" >&2
  echo "  qs              List common dirs (1-${#DIRS[@]}), 0=cancel; then drill down. 0=done." >&2
  echo "  qs -s DIR       Fuzzy search directories by name; pick one to print path" >&2
  echo "  qs -f FILE      Search for file by name; pick one to open in \$EDITOR" >&2
  echo "" >&2
  echo "To navigate:  cd \$(qs)  — or source bashd-init.sh so running qs (or qs -s) cd's for you." >&2
}

main() {
  [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }
  case "${1:-}" in
    -s|--search)
      search_dirs "${2:-}"
      ;;
    -f|--file)
      search_file "${2:-}"
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    "")
      list_common_dirs
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
