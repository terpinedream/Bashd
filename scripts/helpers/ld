#!/bin/bash
# Print cd to the last-used directory (saved by bashd-init.sh on each prompt).
# Output: cd command to stdout so ld() in bashd-init.sh can eval it.
# Usage: ld  (no args). Source bashd-init.sh so the shell records previous CWD and ld changes directory.

usage() {
  echo "Usage: ld" >&2
  echo "  Return to the last-used directory (previous CWD)." >&2
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

lastdir_file="${BASHD_LASTDIR_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/bashd/lastdir}"

[[ ! -f "$lastdir_file" ]] && { echo "✗ No last directory saved. Source bashd-init.sh in your shell config so the previous CWD is recorded." >&2; exit 1; }

path=$(cat "$lastdir_file")
[[ -z "$path" ]] && { echo "✗ Last directory path is empty" >&2; exit 1; }
[[ ! -d "$path" ]] && { echo "✗ Last directory no longer exists: $path" >&2; exit 1; }

printf 'cd %q\n' "$path"
