#!/bin/bash
# Script to move a file from CWD to parent directory
# CWD: /home/user/ -> 'pull file.txt' -> /home/file.txt

if [[ $# -ne 1 ]]; then
    echo "Usage: pull <file>"
    echo "  Moves <file> from current directory to parent directory"
    exit 1
fi

src="$1"
if [[ ! -e "$src" ]]; then
    echo "✗ No such file or directory: $src"
    exit 1
fi
if [[ ! -f "$src" ]] && [[ ! -d "$src" ]]; then
    echo "✗ Not a regular file or directory: $src"
    exit 1
fi

if mv -- "$src" ..; then
    echo "✓ Moved $src to parent directory"
else
    echo "✗ Failed to move $src"
    exit 1
fi
