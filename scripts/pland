#!/bin/bash
# Create incremental plan markdown files for LLM prompts.
# pland        Create next PLAN/PLAN_NN.md with template
# pland -e     Create and open in $EDITOR

EDITOR="${EDITOR:-${VISUAL:-nano}}"

usage() {
    echo "Usage: pland [-e]" >&2
    echo "  pland     Create next PLAN/PLAN_NN.md" >&2
    echo "  pland -e  Create and open in \$EDITOR" >&2
    exit 1
}

OPEN_EDITOR=false
while getopts "eh" opt; do
    case $opt in
        e) OPEN_EDITOR=true ;;
        h) usage ;;
        *) usage ;;
    esac
done

mkdir -p PLAN

max=0
shopt -s nullglob
for f in PLAN/PLAN_[0-9][0-9].md; do
    num=$(basename "$f" .md)
    num="${num#PLAN_}"
    num=$((10#$num))
    [[ $num -gt $max ]] && max=$num
done
shopt -u nullglob

next=$((max + 1))
padded=$(printf '%02d' "$next")
file="PLAN/PLAN_${padded}.md"

cat > "$file" << 'TEMPLATE'
# Plan XX -- [Title]

## Objective
<!-- What are we trying to accomplish? -->

## Context
<!-- Current state, relevant files, constraints -->

## Requirements
<!-- Specific acceptance criteria -->

## Approach
<!-- High-level steps / strategy -->

## Files to Change
<!-- List of files that will be modified -->

## Edge Cases
<!-- What could go wrong? -->

## Testing
<!-- How to verify the changes work -->
TEMPLATE

sed -i "s/Plan XX/Plan $padded/" "$file"

echo "✓ Created $file"

if $OPEN_EDITOR; then
    "$EDITOR" "$file"
fi
