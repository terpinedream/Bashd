#!/bin/bash
# Single-file backup: rename the file to name.ext.bak and create a copy as name.ext (so you keep an editable copy and a .bak).
# Usage: bak <filename>

usage() {
  echo "Usage: bak <filename>" >&2
  echo "  Renames the file to <name>.<ext>.bak and creates a copy as <name>.<ext> (backup + working copy)" >&2
  exit 1
}

[[ $# -ne 1 ]] && usage
file="$1"

[[ ! -f "$file" ]] && {
  echo "✗ Not a file or not found: $file" >&2
  exit 1
}

base=$(basename "$file")
dir=$(dirname "$file")
[[ "$dir" == "." ]] && dir=""
# Backup name: foo.txt -> foo.txt.bak
bakname="${base}.bak"
bakpath="${dir:+$dir/}${bakname}"

[[ -e "$bakpath" ]] && {
  echo "✗ Backup already exists: $bakpath" >&2
  exit 1
}

if mv -- "$file" "$bakpath" && cp -a -- "$bakpath" "$file"; then
  echo "✓ Backed up: $base -> $bakname (working copy: $base)"
else
  echo "✗ Failed" >&2
  exit 1
fi
