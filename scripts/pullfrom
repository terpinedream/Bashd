#!/bin/bash

# Check if correct number of arguments provided
if [ "$#" -ne 2 ]; then
    echo "Usage: pullfrom <remote_path> <local_path>"
    echo "Example: pullfrom ~/Documents/file.txt ~/Desktop/"
    exit 1
fi

REMOTE_PATH="$1"
LOCAL_PATH="$2"
REMOTE_HOST="sudouser@desktop"  # Pulling from desktop

# Pull file from desktop using scp
scp -r "${REMOTE_HOST}:${REMOTE_PATH}" "$LOCAL_PATH"

# Check if transfer was successful
if [ $? -eq 0 ]; then
    echo "✓ Successfully pulled from desktop"
else
    echo "✗ Transfer failed"
    exit 1
fi
