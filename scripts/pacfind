#!/bin/bash
# Script to find specified pacman package
# 'pacfind "keyword"' -> list of files from installed package

if [[ $# -lt 1 ]]; then
    echo "Usage: pacfind <package_name_or_keyword>"
    echo "  pacfind <pkg>     List files for exact package name"
    echo "  pacfind keyword   Search installed packages for keyword, then list files"
    exit 1
fi

target="$1"

# If exact package is installed, list its files
if pacman -Q "$target" &>/dev/null; then
    pacman -Ql "$target"
    exit 0
fi

# Search by keyword: find first matching installed package
pkg=$(pacman -Qs "$target" | grep '^local/' | head -1 | sed 's|^local/||' | awk '{print $1}')
if [[ -z "$pkg" ]]; then
    echo "✗ No installed package matching: $target"
    exit 1
fi

pacman -Ql "$pkg"
