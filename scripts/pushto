#!/bin/bash

if [ "$#" -ne 2 ]; then
  echo "Usage: pushto <local_path> <remote_path>"
  echo "Example: pushto ~/Documents/file.txt ~/Desktop/"
  exit 1
fi

LOCAL_PATH="$1"
REMOTE_PATH="$2"
REMOTE_HOST="HOST@NAME"

scp -r "$LOCAL_PATH" "${REMOTE_HOST}:${REMOTE_PATH}"

if [ $? -eq 0 ]; then
  echo "✓ Successfully pushed to remote"
else
  echo "✗ Transfer failed"
  exit 1
fi
